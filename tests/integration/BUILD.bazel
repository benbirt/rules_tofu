"""Bazel-in-Bazel negative tests: assert that misusing the rules_tofu rules
fails with a stable, user-visible error message.

Each case names a sub-workspace, a target inside it under
`cases/<case>/`, and a short stderr fragment expected when the nested Bazel
fails on that target: `_CASES` drives the target with `bazel build`,
`_RUN_CASES` with `bazel run`. Most cases live in `broken_workspace`, whose
single MODULE.bazel they share, and run as one test against one nested
Bazel: starting a server and fetching and analysing rules_tofu's
dependencies costs more than any case, so after the first they are
incremental builds. A case whose break *is* the module graph needs a
sub-workspace of its own (`broken_module`, `lock_dependency`) and a test of
its own. The child workspace packages are excluded from the parent Bazel via
the `--deleted_packages` flag in `.bazelrc` (the "deleted packages" trick
recommended by rules_bazel_integration_test), so the outer Bazel never
analyzes the intentionally-broken case targets when expanding `//...`.
"""

load("@bazel_binaries//:defs.bzl", "bazel_binaries")
load(
    "@rules_bazel_integration_test//bazel_integration_test:defs.bzl",
    "bazel_integration_test",
    "integration_test_utils",
)
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@running_bazel//:version.bzl", "RUNNING_BAZEL_VERSION")
load("//toolchain:versions.bzl", "KNOWN_VERSIONS")
load(":cases.bzl", "case_line")

sh_binary(
    name = "assert_bazel_fails",
    srcs = ["assert_bazel_fails.sh"],
    data = ["nested_bazel.sh"],
)

# Each sub-workspace is a single Bazel module, so every case ships the whole
# thing; glob once per workspace and share the lists.
_WORKSPACE_FILES = {
    "broken_module": integration_test_utils.glob_workspace_files("broken_module") + [
        "//:local_repository_files",
    ],
    "broken_workspace": integration_test_utils.glob_workspace_files("broken_workspace") + [
        "//:local_repository_files",
    ],
    "custom_toolchain": integration_test_utils.glob_workspace_files("custom_toolchain") + [
        "//:local_repository_files",
    ],
    "lock_dependency": integration_test_utils.glob_workspace_files("lock_dependency") + [
        "//:local_repository_files",
    ],
}

# Failures raised by the outer Bazel itself — loading, analysis, or an action
# the rules emit. Driven by `bazel build`, the driver's default command.
_CASES = [
    # (case_name, workspace_path, target inside that workspace, stderr fragment)
    ("duplicate_vars", "broken_workspace", "//cases/duplicate_vars:dup", "declared in both"),
    ("duplicate_vars_hcl", "broken_workspace", "//cases/duplicate_vars:dup_hcl", "declared in both"),
    ("validate_fails", "broken_workspace", "//cases/validate_fails:bad", "Reference to undeclared input variable"),
    ("missing_provider", "broken_workspace", "//cases/missing_provider:missing", "Add \"@tf_providers//hashicorp/random\" to the providers of"),
    ("lock_file_smuggled", "broken_workspace", "//cases/lock_file_smuggled:smuggled", "refusing to validate"),
    ("auto_tfvars_conflict", "broken_workspace", "//cases/auto_tfvars_conflict:deploy", "collides with the generated"),
    ("tfvars_in_library_data", "broken_workspace", "//cases/auto_tfvars_in_data:library_tfvars", "cases/auto_tfvars_in_data/terraform.tfvars` in `data` is a variables file that OpenTofu loads by itself"),
    ("auto_tfvars_in_library_data", "broken_workspace", "//cases/auto_tfvars_in_data:library_auto_tfvars", "cases/auto_tfvars_in_data/extra.auto.tfvars` in `data` is a variables file that OpenTofu loads by itself"),
    ("auto_tfvars_json_in_deploy_data", "broken_workspace", "//cases/auto_tfvars_in_data:deploy_auto_tfvars_json", "cases/auto_tfvars_in_data/env/prod.auto.tfvars.json` in `data` is a variables file that OpenTofu loads by itself"),
    ("tfvars_json_in_test_data", "broken_workspace", "//cases/auto_tfvars_in_data:test_tfvars_json", "cases/auto_tfvars_in_data/terraform.tfvars.json` in `data` is a variables file that OpenTofu loads by itself"),
    ("deploy_deps_only", "broken_workspace", "//cases/deploy_without_configuration:deps_only", "has no configuration file in its root module's directory, `cases/deploy_without_configuration/`"),
    ("deploy_subdirectory_only", "broken_workspace", "//cases/deploy_without_configuration:subdirectory_only", "only reached by `module` blocks in files of that directory"),
    ("module_source_missing", "broken_workspace", "//cases/module_source_missing:lib", "no dep provides source"),
    ("module_dep_unused", "broken_workspace", "//cases/module_dep_unused:lib", "no module call uses"),
    ("module_source_duplicate", "broken_workspace", "//cases/module_source_duplicate:lib", "both have module_source"),
    ("module_version_mismatch", "broken_workspace", "//cases/module_version_mismatch:lib", "is no longer acceptable"),
    ("module_local_external", "broken_workspace", "//cases/module_local_external:lib", "is in another Bazel repository"),
    ("test_file_in_srcs", "broken_workspace", "//cases/test_file_in_srcs:lib", "list it in the srcs of a `tf_test`"),
    ("test_dirs_split", "broken_workspace", "//cases/test_dirs_split:split", "test files must be in one directory"),
    ("test_helper_missing", "broken_workspace", "//cases/test_helper_missing:test", "is not in the work tree; add the tf_library"),
    ("malformed_var_file", "broken_workspace", "//cases/malformed_var_file:deploy", "parse:"),
    ("conflicting_providers", "broken_workspace", "//cases/conflicting_providers:lib", "conflicting versions"),
    ("registry_sha256_mismatch", "broken_workspace", "//cases/registry_sha256_mismatch:lib", "but the registry reports"),
    ("provider_repo_private", "broken_workspace", "//cases/provider_repo_private:lib", "Visibility error"),
    ("stale_lock", "broken_workspace", "//cases/stale_lock:lib", "bazel run @tf_providers//:pin"),
    ("duplicate_root_version", "broken_module", "//cases/duplicate_root_version:lib", "declares tofu.version more than once"),
    # A dependency's from_lock is ignored, so the root must supply its providers.
    ("dependency_lock_ignored", "lock_dependency", "@lib_module//:lib", "BUILD file not found in directory 'hashicorp/null'"),
    # Dependencies' tags that can't be settled on one version fail the
    # provider when it is used, not the extension: the case above still fails
    # for its own reason, in the same module graph.
    ("unorderable_versions", "lock_dependency", "@lib_module//:unorderable", "rules_tofu can only order plain numeric versions"),
    # A toolchain the root module registers is the one selected, ahead of
    # rules_tofu's downloads. Its stand-in `tofu` fails with this message.
    ("custom_toolchain", "custom_toolchain", "//:lib", "custom tofu toolchain selected"),
]

# Failures raised at runtime by the launcher a `tf_deploy` generates: the
# target builds cleanly and the refusal comes from the runner process. These
# also cover the plumbing from BUILD attribute to runner flag, which the
# runner's Go unit tests cannot see.
_RUN_CASES = [
    # (case_name, workspace_path, target inside that workspace, stderr fragment)
    ("ephemeral_state_refused", "broken_workspace", "//cases/ephemeral_state_refused:deploy.apply", "allow_ephemeral_state"),
    # A `backend "local"` with a relative path keeps state under bazel-bin too.
    ("local_backend_refused", "broken_workspace", "//cases/local_backend_refused:deploy.apply", "does not provably keep state outside"),
]

# A nested Bazel is a whole build system: it writes to the repository cache
# that setup-bazel puts in ~/.bazelrc, outside the sandbox's writable paths.
# Under darwin-sandbox that fails (a hang on "could not acquire lock on repo
# contents cache", or "module ... not found in registries"), so run it
# unsandboxed. `exclusive` keeps the nested servers from competing.
_TAGS = [
    "exclusive",
    "no-sandbox",
]

# The nested Bazel (`bazel_binaries.versions.current`) is the version of the
# Bazel running the tests. Every test passes that version to its driver,
# where nested_bazel.sh checks the nested Bazel really is it.
_ENV = {"RUNNING_BAZEL_VERSION": RUNNING_BAZEL_VERSION}

_COMMANDS = [("build", _CASES), ("run", _RUN_CASES)]

# The cases sharing `broken_workspace`, as one test; see the module docstring.
# `bazel test :broken_workspace_test --test_env=ONLY_CASES=<name>,<name>`
# runs a selection.
_BUNDLED_WORKSPACE = "broken_workspace"

bazel_integration_test(
    name = _BUNDLED_WORKSPACE + "_test",
    timeout = "long",
    bazel_binaries = bazel_binaries,
    bazel_version = bazel_binaries.versions.current,
    env = _ENV | {
        "CASES": "\n".join([
            case_line(case_name, command, target, pattern)
            for (command, cases) in _COMMANDS
            for (case_name, workspace, target, pattern) in cases
            if workspace == _BUNDLED_WORKSPACE
        ]),
    },
    tags = _TAGS,
    test_runner = ":assert_bazel_fails",
    workspace_files = _WORKSPACE_FILES[_BUNDLED_WORKSPACE],
    workspace_path = _BUNDLED_WORKSPACE,
)

# The cases with a sub-workspace of their own, one test each.
[
    bazel_integration_test(
        name = case_name + "_test",
        timeout = "moderate",
        bazel_binaries = bazel_binaries,
        bazel_version = bazel_binaries.versions.current,
        env = _ENV | {"CASES": case_line(case_name, command, target, pattern)},
        tags = _TAGS,
        test_runner = ":assert_bazel_fails",
        workspace_files = _WORKSPACE_FILES[workspace],
        workspace_path = workspace,
    )
    for (command, cases) in _COMMANDS
    for (case_name, workspace, target, pattern) in cases
    if workspace != _BUNDLED_WORKSPACE
]

# A positive test: a workspace's first `pin`, then a provider update
# as Dependabot or Renovate makes it (versions.tf and .terraform.lock.hcl
# only), which must build with MODULE.bazel.lock untouched, then a root tag
# for the locked provider, which must fail the build but leave `pin`
# runnable. See lock_update_test.sh.
sh_binary(
    name = "lock_update_driver",
    srcs = ["lock_update_test.sh"],
    data = ["nested_bazel.sh"],
)

bazel_integration_test(
    name = "lock_update_test",
    timeout = "moderate",
    bazel_binaries = bazel_binaries,
    bazel_version = bazel_binaries.versions.current,
    env = _ENV,
    tags = _TAGS,
    test_runner = ":lock_update_driver",
    workspace_files = integration_test_utils.glob_workspace_files("lock_update") + [
        "//:local_repository_files",
    ],
    workspace_path = "lock_update",
)

# The other positive test: a root module calls a tf_library from another
# Bazel module by its module_source, which in turn calls one from a third,
# and builds and plans offline. The module manifest this relies on is tofu's
# internal format, so it runs with every tofu version rules_tofu pins. See
# module_dependency_test.sh.
sh_binary(
    name = "module_dependency_driver",
    srcs = ["module_dependency_test.sh"],
    data = ["nested_bazel.sh"],
)

[
    bazel_integration_test(
        name = "module_dependency_{}_test".format(version.replace(".", "_")),
        timeout = "moderate",
        bazel_binaries = bazel_binaries,
        bazel_version = bazel_binaries.versions.current,
        env = _ENV | {"TOFU_VERSION": version},
        tags = _TAGS,
        test_runner = ":module_dependency_driver",
        workspace_files = integration_test_utils.glob_workspace_files("module_dependency") + [
            "//:local_repository_files",
        ],
        workspace_path = "module_dependency",
    )
    for version in KNOWN_VERSIONS
]

# The launchers a `tf_deploy` generates, run for real: `.apply` under
# `bazel run`, then the built `.destroy` launcher directly from another
# directory, sharing the state of a `backend "local"` with a relative path in
# the deploy's run directory. See run_directory_test.sh.
sh_binary(
    name = "run_directory_driver",
    srcs = ["run_directory_test.sh"],
    data = ["nested_bazel.sh"],
)

bazel_integration_test(
    name = "run_directory_test",
    timeout = "moderate",
    bazel_binaries = bazel_binaries,
    bazel_version = bazel_binaries.versions.current,
    env = _ENV,
    tags = _TAGS,
    test_runner = ":run_directory_driver",
    workspace_files = integration_test_utils.glob_workspace_files("run_directory") + [
        "//:local_repository_files",
    ],
    workspace_path = "run_directory",
)

# tf_modules.module: git, archive and registry modules, fetched and pinned by
# commit or digest, with the providers a module requires carried to its
# callers. See tf_modules_test.sh.
sh_binary(
    name = "tf_modules_driver",
    srcs = ["tf_modules_test.sh"],
    data = ["nested_bazel.sh"],
)

bazel_integration_test(
    name = "tf_modules_test",
    timeout = "moderate",
    bazel_binaries = bazel_binaries,
    bazel_version = bazel_binaries.versions.current,
    env = _ENV,
    tags = _TAGS,
    test_runner = ":tf_modules_driver",
    workspace_files = integration_test_utils.glob_workspace_files("tf_modules") + [
        "//:local_repository_files",
    ],
    workspace_path = "tf_modules",
)

# `.fmt` and `.fmt_check` act on the files in `srcs` by name, in
# subdirectories too, and on nothing else in the package; a target without
# `srcs` has neither. Which extensions `tofu fmt` accepts by name is the
# binary's to decide, so this runs with every tofu version rules_tofu pins.
# See fmt_test.sh.
sh_binary(
    name = "fmt_driver",
    srcs = ["fmt_test.sh"],
    data = ["nested_bazel.sh"],
)

[
    bazel_integration_test(
        name = "fmt_{}_test".format(version.replace(".", "_")),
        timeout = "moderate",
        bazel_binaries = bazel_binaries,
        bazel_version = bazel_binaries.versions.current,
        env = _ENV | {"TOFU_VERSION": version},
        tags = _TAGS,
        test_runner = ":fmt_driver",
        workspace_files = integration_test_utils.glob_workspace_files("fmt") + [
            "//:local_repository_files",
        ],
        workspace_path = "fmt",
    )
    for version in KNOWN_VERSIONS
]
