"""Bazel-in-Bazel negative tests: assert that misusing the rules_tofu rules
fails with a stable, user-visible error message.

Each case names a sub-workspace, a target inside it under
`cases/<case>/`, and a short stderr fragment expected when the nested Bazel
fails on that target: `_CASES` drives the target with `bazel build`,
`_RUN_CASES` with `bazel run`. Most cases live in `broken_workspace`, whose
single MODULE.bazel they share; a case whose break *is* the module graph
needs a sub-workspace of its own (`broken_module`, `lock_dependency`). The child workspace
packages are excluded from the parent Bazel via the `--deleted_packages`
flag in `.bazelrc` (the "deleted packages" trick recommended by
rules_bazel_integration_test), so the outer Bazel never analyzes the
intentionally-broken case targets when expanding `//...`.
"""

load("@bazel_binaries//:defs.bzl", "bazel_binaries")
load(
    "@rules_bazel_integration_test//bazel_integration_test:defs.bzl",
    "bazel_integration_test",
    "integration_test_utils",
)
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//toolchain:versions.bzl", "KNOWN_VERSIONS")

sh_binary(
    name = "assert_bazel_fails",
    srcs = ["assert_bazel_fails.sh"],
)

# Each sub-workspace is a single Bazel module, so every case ships the whole
# thing; glob once per workspace and share the lists.
_WORKSPACE_FILES = {
    "broken_module": integration_test_utils.glob_workspace_files("broken_module") + [
        "//:local_repository_files",
    ],
    "broken_workspace": integration_test_utils.glob_workspace_files("broken_workspace") + [
        "//:local_repository_files",
    ],
    "lock_dependency": integration_test_utils.glob_workspace_files("lock_dependency") + [
        "//:local_repository_files",
    ],
}

# Failures raised by the outer Bazel itself — loading, analysis, or an action
# the rules emit. Driven by `bazel build`, the driver's default command.
_CASES = [
    # (case_name, workspace_path, target inside that workspace, stderr fragment)
    ("duplicate_vars", "broken_workspace", "//cases/duplicate_vars:dup", "declared in both"),
    ("duplicate_vars_hcl", "broken_workspace", "//cases/duplicate_vars:dup_hcl", "declared in both"),
    ("validate_fails", "broken_workspace", "//cases/validate_fails:bad", "Reference to undeclared input variable"),
    ("missing_provider", "broken_workspace", "//cases/missing_provider:missing", "Failed to query available provider packages"),
    ("lock_file_smuggled", "broken_workspace", "//cases/lock_file_smuggled:smuggled", "refusing to validate"),
    ("auto_tfvars_conflict", "broken_workspace", "//cases/auto_tfvars_conflict:deploy", "collides with the generated"),
    ("module_source_missing", "broken_workspace", "//cases/module_source_missing:lib", "no dep provides source"),
    ("module_dep_unused", "broken_workspace", "//cases/module_dep_unused:lib", "no module call uses"),
    ("module_source_duplicate", "broken_workspace", "//cases/module_source_duplicate:lib", "both have module_source"),
    ("module_version_mismatch", "broken_workspace", "//cases/module_version_mismatch:lib", "is no longer acceptable"),
    ("module_local_external", "broken_workspace", "//cases/module_local_external:lib", "is in another Bazel repository"),
    ("malformed_var_file", "broken_workspace", "//cases/malformed_var_file:deploy", "parse:"),
    ("conflicting_providers", "broken_workspace", "//cases/conflicting_providers:lib", "conflicting versions"),
    ("registry_sha256_mismatch", "broken_workspace", "//cases/registry_sha256_mismatch:lib", "but the registry reports"),
    ("provider_repo_private", "broken_workspace", "//cases/provider_repo_private:lib", "Visibility error"),
    ("stale_lock", "broken_workspace", "//cases/stale_lock:lib", "bazel run @tf_providers//:pin"),
    ("duplicate_root_version", "broken_module", "//cases/duplicate_root_version:lib", "declares tofu.version more than once"),
    # A dependency's from_lock is ignored, so the root must supply its providers.
    ("dependency_lock_ignored", "lock_dependency", "@lib_module//:lib", "BUILD file not found in directory 'hashicorp/null'"),
]

# Failures raised at runtime by the launcher a `tf_deploy` generates: the
# target builds cleanly and the refusal comes from the runner process. These
# also cover the plumbing from BUILD attribute to runner flag, which the
# runner's Go unit tests cannot see.
_RUN_CASES = [
    # (case_name, workspace_path, target inside that workspace, stderr fragment)
    ("ephemeral_state_refused", "broken_workspace", "//cases/ephemeral_state_refused:deploy.apply", "allow_ephemeral_state"),
]

# A nested Bazel is a whole build system: it writes to the repository cache
# that setup-bazel puts in ~/.bazelrc, outside the sandbox's writable paths.
# Under darwin-sandbox that fails (a hang on "could not acquire lock on repo
# contents cache", or "module ... not found in registries"), so run it
# unsandboxed. `exclusive` keeps the nested servers from competing.
_TAGS = [
    "exclusive",
    "no-sandbox",
]

[
    bazel_integration_test(
        name = case_name + "_test",
        timeout = "moderate",
        bazel_binaries = bazel_binaries,
        bazel_version = bazel_binaries.versions.current,
        env = {
            "TARGET": target,
            "EXPECTED_PATTERN": pattern,
        },
        tags = _TAGS,
        test_runner = ":assert_bazel_fails",
        workspace_files = _WORKSPACE_FILES[workspace],
        workspace_path = workspace,
    )
    for (case_name, workspace, target, pattern) in _CASES
]

[
    bazel_integration_test(
        name = case_name + "_test",
        timeout = "moderate",
        bazel_binaries = bazel_binaries,
        bazel_version = bazel_binaries.versions.current,
        env = {
            "BAZEL_COMMAND": "run",
            "TARGET": target,
            "EXPECTED_PATTERN": pattern,
        },
        tags = _TAGS,
        test_runner = ":assert_bazel_fails",
        workspace_files = _WORKSPACE_FILES[workspace],
        workspace_path = workspace,
    )
    for (case_name, workspace, target, pattern) in _RUN_CASES
]

# A positive test: a workspace's first `pin`, then a provider update
# as Dependabot or Renovate makes it (versions.tf and .terraform.lock.hcl
# only), which must build with MODULE.bazel.lock untouched. See
# lock_update_test.sh.
sh_binary(
    name = "lock_update_driver",
    srcs = ["lock_update_test.sh"],
)

bazel_integration_test(
    name = "lock_update_test",
    timeout = "moderate",
    bazel_binaries = bazel_binaries,
    bazel_version = bazel_binaries.versions.current,
    tags = _TAGS,
    test_runner = ":lock_update_driver",
    workspace_files = integration_test_utils.glob_workspace_files("lock_update") + [
        "//:local_repository_files",
    ],
    workspace_path = "lock_update",
)

# The other positive test: a root module calls a tf_library from another
# Bazel module by its module_source, which in turn calls one from a third,
# and builds and plans offline. The module manifest this relies on is tofu's
# internal format, so it runs with every tofu version rules_tofu pins. See
# module_dependency_test.sh.
sh_binary(
    name = "module_dependency_driver",
    srcs = ["module_dependency_test.sh"],
)

[
    bazel_integration_test(
        name = "module_dependency_{}_test".format(version.replace(".", "_")),
        timeout = "moderate",
        bazel_binaries = bazel_binaries,
        bazel_version = bazel_binaries.versions.current,
        env = {"TOFU_VERSION": version},
        tags = _TAGS,
        test_runner = ":module_dependency_driver",
        workspace_files = integration_test_utils.glob_workspace_files("module_dependency") + [
            "//:local_repository_files",
        ],
        workspace_path = "module_dependency",
    )
    for version in KNOWN_VERSIONS
]

# tf_modules.module: git, archive and registry modules, fetched and pinned by
# commit or digest, with the providers a module requires carried to its
# callers. See tf_modules_test.sh.
sh_binary(
    name = "tf_modules_driver",
    srcs = ["tf_modules_test.sh"],
)

bazel_integration_test(
    name = "tf_modules_test",
    timeout = "moderate",
    bazel_binaries = bazel_binaries,
    bazel_version = bazel_binaries.versions.current,
    tags = _TAGS,
    test_runner = ":tf_modules_driver",
    workspace_files = integration_test_utils.glob_workspace_files("tf_modules") + [
        "//:local_repository_files",
    ],
    workspace_path = "tf_modules",
)
