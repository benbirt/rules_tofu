"""Module declaration for the nested Bazel invocations of `lock_update_test`.

The root module pins its providers with `tf_providers.from_lock`, and starts
without a lock: the test writes the first one with `pin`, then updates it as
Dependabot or Renovate would, and checks that MODULE.bazel.lock needn't change.
"""

module(
    name = "rules_tofu_lock_update_tests",
    version = "0.0.0",
)

# Version is irrelevant: `local_path_override` below always wins (same
# pattern as broken_workspace and e2e/smoke). The test rewrites the path when
# it copies this workspace somewhere writable.
bazel_dep(name = "rules_tofu", version = "0.0.0")
local_path_override(
    module_name = "rules_tofu",
    path = "../../..",
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_go", version = "0.60.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.3")

tofu = use_extension("@rules_tofu//toolchain:extensions.bzl", "tofu")
use_repo(tofu, "tofu_toolchains")

register_toolchains("@tofu_toolchains//:all")

tf_providers = use_extension("@rules_tofu//tf/providers:extensions.bzl", "tf_providers")
tf_providers.from_lock()
use_repo(tf_providers, "tf_providers")
