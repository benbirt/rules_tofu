load("@rules_tofu//tf:defs.bzl", "tf_library")

# Names its provider before any lock exists, as the README's quick start does.
tf_library(
    name = "versions",
    srcs = ["versions.tf"],
    providers = ["@tf_providers//hashicorp/null"],
)

# A second root module in the package requiring the same local name with a
# different constraint: OpenTofu would reject both files in one module, so
# pin must read each target separately and lock against both (issue #99). It
# also calls a submodule of a bundle library from another Bazel module, which
# adds a third constraint (issue #123).
tf_library(
    name = "floor",
    srcs = ["floor.tf"],
    providers = ["@tf_providers//hashicorp/null"],
    deps = ["@bundle_module//bundle"],
)
