load("@rules_tofu//tf:defs.bzl", "tf_library")

# Names its provider before any lock exists, as the README's quick start does.
tf_library(
    name = "versions",
    srcs = ["versions.tf"],
    fmt_test = False,
    providers = ["@tf_providers//hashicorp/null"],
)

# A second root module in the package, requiring the provider under the same
# local name with a constraint of its own: pin reads the package's files
# together, and must lock against both (issue #99). It also calls a
# submodule of a bundle library from another Bazel module, which has a
# constraint of its own again (issue #123).
tf_library(
    name = "floor",
    srcs = ["floor.tf"],
    fmt_test = False,
    providers = ["@tf_providers//hashicorp/null"],
    deps = ["@bundle_module//bundle"],
)
