load("@rules_tofu//tf:defs.bzl", "tf_deploy")

# main.tf has no required_providers block. Its local_file resource implies
# hashicorp/local. hashicorp/null and hashicorp/time come with the network
# module, the latter for its `peering` submodule, and hashicorp/tls with dns.
tf_deploy(
    name = "app",
    srcs = ["main.tf"],
    allow_ephemeral_state = True,
    providers = ["@tf_providers//hashicorp/local"],
    deps = [
        "@tf_modules//cloudposse/label/null",
        "@tf_modules//dns",
        "@tf_modules//network",
        "@tf_modules//plain",
    ],
)
