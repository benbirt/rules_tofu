load("@rules_tofu//tf:defs.bzl", "tf_deploy")

# No providers: hashicorp/null comes with the network module.
tf_deploy(
    name = "app",
    srcs = ["main.tf"],
    allow_ephemeral_state = True,
    deps = [
        "@tf_modules//cloudposse/label/null",
        "@tf_modules//dns",
        "@tf_modules//network",
    ],
)
