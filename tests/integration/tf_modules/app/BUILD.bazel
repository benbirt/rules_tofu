load("@rules_tofu//tf:defs.bzl", "tf_deploy")

# main.tf requires no providers itself. hashicorp/null and hashicorp/time come
# with the network module, the latter for its `peering` submodule.
tf_deploy(
    name = "app",
    srcs = ["main.tf"],
    allow_ephemeral_state = True,
    deps = [
        "@tf_modules//cloudposse/label/null",
        "@tf_modules//dns",
        "@tf_modules//network",
        "@tf_modules//plain",
    ],
)
