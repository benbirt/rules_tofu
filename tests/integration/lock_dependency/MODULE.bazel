"""Module declaration for the nested Bazel invocation asserting that a
dependency's `tf_providers.from_lock` is ignored.

`lib_module` stands in for a Bazel module developed with its own lock and then
depended on. Only the root module's lock counts, as in OpenTofu, so its lock
(deliberately unreadable) is never read, and the `@tf_providers` hub it names
in `use_repo` exists even though this root declares no providers. The root
doesn't supply `hashicorp/null`, which `lib_module`'s library needs, so
building that library fails naming the missing provider.
"""

module(
    name = "rules_tofu_lock_dependency_tests",
    version = "0.0.0",
)

# Version is irrelevant: `local_path_override` below always wins (same
# pattern as broken_workspace and e2e/smoke).
bazel_dep(name = "rules_tofu", version = "0.0.0")
local_path_override(
    module_name = "rules_tofu",
    path = "../../..",
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_go", version = "0.60.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.3")

tofu = use_extension("@rules_tofu//toolchain:extensions.bzl", "tofu")
use_repo(tofu, "tofu_toolchains")

register_toolchains("@tofu_toolchains//:all")

bazel_dep(name = "lib_module", version = "0.0.0")
local_path_override(
    module_name = "lib_module",
    path = "lib_module",
)
