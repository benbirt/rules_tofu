"""A dependency module that pins providers with its own lock, as it would
when developed as a root module. See ../MODULE.bazel."""

module(
    name = "lib_module",
    version = "0.0.0",
)

bazel_dep(name = "rules_tofu", version = "0.0.0")

tf_providers = use_extension("@rules_tofu//tf/providers:extensions.bzl", "tf_providers")
tf_providers.from_lock(lock_file = "//:.terraform.lock.hcl")

# A 0.5-style registry-provider tag without `url_template` or `sha256`, which
# `check_tag` rejects in a root module. Dependency tags are ignored regardless
# of attributes, so extension evaluation succeeds (`//:lib` still fails for its
# own reason) and only `@tf_providers//acme/tagged` (`//:tagged`) fails to
# load, reporting that the root module does not pin it.
tf_providers.provider(
    source = "acme/tagged",
    version = "1.9.0",
)
use_repo(tf_providers, "tf_providers")
