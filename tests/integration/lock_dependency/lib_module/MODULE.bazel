"""A dependency module that pins providers with its own lock, as it would
when developed as a root module. See ../MODULE.bazel."""

module(
    name = "lib_module",
    version = "0.0.0",
)

bazel_dep(name = "rules_tofu", version = "0.0.0")

tf_providers = use_extension("@rules_tofu//tf/providers:extensions.bzl", "tf_providers")
tf_providers.from_lock()

# Two requests for one provider that can't be ordered, as two dependencies
# of the root might make between them, and the root pins neither. That is
# the root's to settle, and must fail only a build that uses the provider
# (`//:unorderable`), never the extension: `//:lib` still fails for its own
# reason.
tf_providers.provider(
    source = "acme/unorderable",
    version = "1.9.0",
)
tf_providers.provider(
    source = "acme/unorderable",
    version = "2.0.0-rc1",
)
use_repo(tf_providers, "tf_providers")
