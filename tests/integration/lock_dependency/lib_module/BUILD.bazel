load("@rules_tofu//tf:defs.bzl", "tf_library")

# Declares only a constraint, and leaves the version to the root module.
tf_library(
    name = "lib",
    srcs = ["main.tf"],
    fmt_test = False,
    providers = ["@tf_providers//hashicorp/null"],
    visibility = ["//visibility:public"],
)

# Names the provider this module tags, which the root module does not pin.
tf_library(
    name = "tagged",
    srcs = ["main.tf"],
    fmt_test = False,
    providers = ["@tf_providers//acme/tagged"],
    visibility = ["//visibility:public"],
)
