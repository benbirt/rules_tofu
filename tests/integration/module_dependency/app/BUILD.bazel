load("@rules_tofu//tf:defs.bzl", "tf_deploy", "tf_test")

tf_deploy(
    name = "app",
    srcs = ["main.tf"],
    allow_ephemeral_state = True,
    deps = ["@network_module//vpc"],
)

# Same configuration as :app, with a backend "local" and allow_ephemeral_state
# left False. OpenTofu merges backend_override.tf over backend.tf and evaluates
# var.state_root during `tofu init`; the runner checks the recorded paths. The
# driver verifies that apply is refused while state_root is relative, then
# rewrites state_root to an absolute path outside bazel-out and applies.
tf_deploy(
    name = "durable",
    srcs = [
        "backend.tf",
        "backend_override.tf",
        "main.tf",
    ],
    vars = {"state_root": "state"},
    deps = ["@network_module//vpc"],
)

# The deploy's test loads the dns module from a `.tofutest.hcl` run block,
# so building it checks the manifest key tofu uses for that extension. The
# driver runs it too, on every pinned tofu. Because the deploy reaches dns
# only through vpc, app_test adds @dns_module//:dns to deps.
tf_test(
    name = "app_test",
    srcs = ["tests/dns.tofutest.hcl"],
    module = ":app",
    deps = ["@dns_module//:dns"],
)
