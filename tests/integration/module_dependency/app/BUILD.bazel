load("@rules_tofu//tf:defs.bzl", "tf_deploy", "tf_test")

tf_deploy(
    name = "app",
    srcs = ["main.tf"],
    allow_ephemeral_state = True,
    deps = ["@network_module//vpc"],
)

# The deploy's test loads the dns module from a `.tofutest.hcl` run block,
# so building it checks the manifest key tofu uses for that extension. The
# driver runs it too, on every pinned tofu. A test lists what it uses itself:
# vpc, which the deploy's root module calls, and dns, which the run block
# loads and the deploy only reaches through vpc.
tf_test(
    name = "app_test",
    srcs = ["tests/dns.tofutest.hcl"],
    fmt_test = False,
    module = ":app",
    deps = [
        "@dns_module//:dns",
        "@network_module//vpc",
    ],
)
