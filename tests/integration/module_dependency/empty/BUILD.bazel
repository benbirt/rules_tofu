load("@rules_tofu//tf:defs.bzl", "tf_library", "tf_test")

# Libraries with an empty root module (issue #119). :lib has only deps in
# another package and :nothing has no inputs at all, so neither creates an
# empty/ directory in the work tree. Both build.
tf_library(
    name = "lib",
    deps = ["//nested:lib"],
)

tf_library(
    name = "nothing",
)

# tf_test on an empty root module. Building it validates the test file, and the
# driver also runs it with `bazel test`.
tf_test(
    name = "test",
    srcs = ["tests/main.tftest.hcl"],
    module = ":lib",
    # tests/main.tftest.hcl loads ../nested in a run block.
    deps = ["//nested:lib"],
)
