"""Module declaration for the nested Bazel invocation in which a root module
calls tf_library targets from other Bazel modules by their `module_source`.

`network_module` and `dns_module` stand in for Bazel modules that ship
OpenTofu modules. The root's `//app` calls `network_module`'s `vpc` by its
address, and `vpc` in turn calls `dns_module`'s library by its own, so the
generated module manifest records a chain across three repositories.
"""

module(
    name = "rules_tofu_module_dependency_tests",
    version = "0.0.0",
)

# Version is irrelevant: `local_path_override` below always wins (same
# pattern as broken_workspace and e2e/smoke).
bazel_dep(name = "rules_tofu", version = "0.0.0")
local_path_override(
    module_name = "rules_tofu",
    path = "../../..",
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_go", version = "0.60.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.3")

tofu = use_extension("@rules_tofu//toolchain:extensions.bzl", "tofu")
use_repo(tofu, "tofu_toolchains")

register_toolchains("@tofu_toolchains//:all")

bazel_dep(name = "network_module", version = "0.0.0")
local_path_override(
    module_name = "network_module",
    path = "network_module",
)

bazel_dep(name = "dns_module", version = "0.0.0")
local_path_override(
    module_name = "dns_module",
    path = "dns_module",
)
