"""Module declaration for the nested Bazel invocation used by the negative
integration tests.

The sub-workspace packages are excluded from the parent Bazel via the
--deleted_packages flag in .bazelrc (the "deleted packages" trick recommended
by rules_bazel_integration_test), which prevents the outer Bazel from
analysing the intentionally-failing case targets when expanding //... at the
root. The nested Bazel consumes rules_tofu via local_path_override exactly as
a downstream user would.
"""

module(
    name = "rules_tofu_negative_tests",
    version = "0.0.0",
)

# Version is irrelevant: `local_path_override` below always wins (same
# pattern as e2e/smoke).
bazel_dep(name = "rules_tofu", version = "0.0.0")
local_path_override(
    module_name = "rules_tofu",
    path = "../../..",
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_go", version = "0.60.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.3")

tofu = use_extension("@rules_tofu//toolchain:extensions.bzl", "tofu")
use_repo(tofu, "tofu_toolchains")

register_toolchains("@tofu_toolchains//:all")

tf_providers = use_extension("@rules_tofu//tf/providers:extensions.bzl", "tf_providers")

# Workspace lock: pins hashicorp/null 3.2.4 for stale_lock, and
# hashicorp/random (~6 MB per platform) for cases whose dependencies need a
# pinned provider (strict_deps_provider, empty_root_test_provider).
tf_providers.from_lock(lock_file = "//lock:.terraform.lock.hcl")
use_repo(tf_providers, "tf_providers")
