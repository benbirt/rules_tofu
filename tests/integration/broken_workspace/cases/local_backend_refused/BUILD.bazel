load("@rules_tofu//tf:defs.bzl", "tf_deploy", "tf_library")

# Like ephemeral_state_refused, this builds cleanly and fails at runtime.
# `main.tf` declares a `backend "local"` with a relative `path`, which resolves
# inside the run directory under bazel-bin and is wiped by `bazel clean`. After
# `tofu init` records that backend, the runner refuses `bazel run :deploy.apply`
# and names the relative `path`. Do not make the path absolute, and do not set
# `allow_ephemeral_state`.
tf_library(
    name = "lib",
    srcs = ["main.tf"],
)

tf_deploy(
    name = "deploy",
    deps = [":lib"],
)
