load("@rules_tofu//tf:defs.bzl", "tf_deploy")

# A deploy's root module is its own package, and :deps_only puts no
# configuration file there (`deps` in another package are only reached by
# `module` blocks in the root's own files). `tofu` validates an empty
# directory and then refuses to plan it, so analysis fails instead.
tf_deploy(
    name = "deps_only",
    allow_ephemeral_state = True,
    deps = ["//cases/deploy_without_configuration/lib"],
)
