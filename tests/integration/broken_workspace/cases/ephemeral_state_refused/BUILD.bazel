load("@rules_tofu//tf:defs.bzl", "tf_deploy", "tf_library")

# Unlike its sibling cases, this one builds cleanly: the failure is at runtime.
# No .tf file declares a backend and `allow_ephemeral_state` defaults to False,
# so the runner refuses `bazel run :deploy.apply` after `tofu init` and names
# `allow_ephemeral_state`. The defaults are the whole point of the fixture: do
# not add a backend block, and do not set the attribute.
tf_library(
    name = "lib",
    srcs = ["main.tf"],
)

tf_deploy(
    name = "deploy",
    deps = [":lib"],
)
