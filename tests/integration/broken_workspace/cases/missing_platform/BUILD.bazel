load("@rules_tofu//tf:defs.bzl", "tf_library")

# broken_workspace/MODULE.bazel tags acme/windows-only for windows_amd64 only,
# while tests run on Linux and macOS. The hub `select()` finds no branch for
# the execution platform and fails analysis without fetching.
tf_library(
    name = "lib",
    srcs = ["main.tf"],
    providers = ["@tf_providers//acme/windows-only"],
)
