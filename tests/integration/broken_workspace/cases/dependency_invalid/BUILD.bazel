load("@rules_tofu//tf:defs.bzl", "tf_deploy", "tf_library", "tf_test")

# Dependency-order failure cases for issue #143. Each target here is valid on
# its own and depends on a broken library, so building or running it fails in
# the dependency's TofuValidate or TofuModules action without checking this
# target.

# Calls ./dep, which fails validation.
tf_library(
    name = "dependant",
    srcs = ["main.tf"],
    fmt_test = False,
    deps = ["//cases/dependency_invalid/dep"],
)

# Same call from a deploy; bazel run on :deploy.plan fails in the build before
# starting the runner.
tf_deploy(
    name = "deploy",
    srcs = ["main.tf"],
    allow_ephemeral_state = True,
    fmt_test = False,
    deps = ["//cases/dependency_invalid/dep"],
)

# Empty root module: would succeed on its own if deps validation were not
# required.
tf_library(
    name = "bundle",
    deps = ["//cases/dependency_invalid/dep"],
)

tf_library(
    name = "sound",
    srcs = ["sound.tf"],
    fmt_test = False,
)

# Valid module under test, broken helper in deps.
tf_test(
    name = "test_helper",
    srcs = ["sound.tftest.hcl"],
    fmt_test = False,
    module = ":sound",
    deps = ["//cases/dependency_invalid/dep"],
)

# Empty root module depending on a library whose TofuModules action fails its
# strict-deps check; would succeed on its own if deps manifests were not
# required.
tf_library(
    name = "manifest_dependant",
    fmt_test = False,
    deps = ["//cases/dependency_invalid/undeclared"],
)
