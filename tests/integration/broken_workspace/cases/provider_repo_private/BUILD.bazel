load("@rules_tofu//tf:defs.bzl", "tf_library")

# Names a provider by its own repo rather than through the hub. That repo is
# an implementation detail: its `:provider` target is visible only to the
# `@tf_providers//<namespace>/<name>` aliases, so analysis fails.
tf_library(
    name = "lib",
    srcs = ["main.tf"],
    fmt_test = False,
    providers = ["@tf_providers_hashicorp_aws//:provider"],
)
