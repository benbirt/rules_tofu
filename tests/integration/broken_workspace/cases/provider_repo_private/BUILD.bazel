load("@rules_tofu//tf:defs.bzl", "tf_library")

# References a per-platform provider repo directly instead of through
# `@tf_providers//<namespace>/<name>`. `:provider` is visible only to the hub,
# so analysis fails with a visibility error.
tf_library(
    name = "lib",
    srcs = ["main.tf"],
    providers = ["@tf_providers_hashicorp_random_linux_amd64//:provider"],
)
