load("@rules_tofu//tf:defs.bzl", "tf_library")

# main.tf declares `required_providers { random = ... }` but the library has
# no `providers = [...]`, so the plugin tree materialized for validate lacks
# hashicorp/random. The modules manifest action reads required_providers and
# fails naming the label to add, before `tofu init -plugin-dir=<empty>` would
# fail with "Failed to query available provider packages".
tf_library(
    name = "missing",
    srcs = ["main.tf"],
    fmt_test = False,
)
