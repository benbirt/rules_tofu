load("@rules_tofu//tf:defs.bzl", "tf_library")

# main.tf declares required_providers { random = ... } and :missing sets no
# providers. The manifest action's strict-deps check (issue #135) fails naming
# "@tf_providers//hashicorp/random" to add. Do not add providers here.
tf_library(
    name = "missing",
    srcs = ["main.tf"],
)

# implied.tf has only resource "random_pet" "name" {}, with no
# required_providers entry. OpenTofu reports the provider the resource implies,
# so the strict-deps check fails as it does for :missing (issue #153). Do not
# add providers here.
tf_library(
    name = "implied",
    srcs = ["implied.tf"],
)
