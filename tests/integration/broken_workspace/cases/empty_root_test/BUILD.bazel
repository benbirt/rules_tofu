load("@rules_tofu//tf:defs.bzl", "tf_library", "tf_test")

# A test of an empty root module whose `run` block loads a module that needs a
# provider. `tofu init` does nothing in a directory without configuration
# files, so it installs no provider and validation fails with `tofu`'s
# "Missing required provider"; the validate action must append what to do.
# Keep main.tftest.hcl in the root module's own directory: `tofu` is given no
# -test-directory there, and the hint must still appear.
tf_library(
    name = "empty",
    deps = ["//cases/empty_root_test/lib"],
)

tf_test(
    name = "test",
    srcs = ["main.tftest.hcl"],
    fmt_test = False,
    module = ":empty",
)
