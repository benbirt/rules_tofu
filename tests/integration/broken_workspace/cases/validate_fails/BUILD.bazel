load("@rules_tofu//tf:defs.bzl", "tf_deploy")

# main.tf references `var.does_not_exist`, which `tofu validate` rejects.
# A launcher's default outputs include its deploy's stamps, so building
# :bad_deploy.plan fails in bad_deploy's validation (issue #143).
tf_deploy(
    name = "bad_deploy",
    srcs = ["main.tf"],
    allow_ephemeral_state = True,
)
