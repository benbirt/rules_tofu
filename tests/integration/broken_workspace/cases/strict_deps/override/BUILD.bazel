load("@rules_tofu//tf:defs.bzl", "tf_library")

# Stand-alone strict-deps failure case (`strict_deps_override`, issue #153).
# main_override.tf overrides the module call in :base's main.tf. Strict deps
# reads :override's srcs without :base's files, so OpenTofu rejects
# main_override.tf and TofuModules appends the override hint. Keep main.tf and
# main_override.tf in separate targets.
tf_library(
    name = "base",
    srcs = [
        "child/main.tf",
        "main.tf",
        "other/main.tf",
    ],
)

tf_library(
    name = "override",
    srcs = ["main_override.tf"],
    deps = [":base"],
)
