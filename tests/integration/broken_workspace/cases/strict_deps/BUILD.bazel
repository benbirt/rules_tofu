load("@rules_tofu//tf:defs.bzl", "tf_library")

# Strict-deps failure cases for issue #135. Each target uses a provider or
# module declared only on its dependency. Building it fails and names what to
# add. Keep these targets broken.

# provider.tf requires hashicorp/random, listed only on
# //cases/strict_deps/random.
tf_library(
    name = "provider",
    srcs = ["provider.tf"],
    fmt_test = False,
    deps = ["//cases/strict_deps/random"],
)

# module.tf calls net by module_source, listed only in mid's deps.
tf_library(
    name = "module",
    srcs = ["module.tf"],
    fmt_test = False,
    deps = ["//cases/strict_deps/mid"],
)

# local.tf calls ./net, whose library is only in mid's deps.
tf_library(
    name = "local",
    srcs = ["local.tf"],
    fmt_test = False,
    deps = ["//cases/strict_deps/mid"],
)
