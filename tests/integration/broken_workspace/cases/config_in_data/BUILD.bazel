load("@rules_tofu//tf:defs.bzl", "tf_library", "tf_test")

# sub/main.tf is configuration, which main.tf calls as a module, but it is
# listed as data. Only srcs are checked against providers and deps, so no
# rule takes a configuration file as data (issue #140). Keep it in data.
tf_library(
    name = "lib",
    srcs = ["main.tf"],
    data = ["sub/main.tf"],
)

tf_library(
    name = "root",
    srcs = ["main.tf"],
    deps = [":sub"],
)

tf_library(
    name = "sub",
    srcs = ["sub/main.tf"],
)

# A test's srcs are test files, so the error must not send the file there.
tf_test(
    name = "test",
    srcs = ["main.tftest.hcl"],
    data = ["fixture/main.tofu.json"],
    module = ":root",
)
