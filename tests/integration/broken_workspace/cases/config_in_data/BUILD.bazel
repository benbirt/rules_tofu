load("@rules_tofu//tf:defs.bzl", "tf_library")

# sub/main.tf is configuration, which main.tf calls as a module, but it is
# listed as data. Only srcs are checked against providers and deps, so no
# rule takes a configuration file as data (issue #140). Keep it in data.
tf_library(
    name = "lib",
    srcs = ["main.tf"],
    data = ["sub/main.tf"],
    fmt_test = False,
)
