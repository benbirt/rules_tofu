load("@rules_tofu//tf:defs.bzl", "tf_deploy", "tf_library", "tf_test")

# OpenTofu loads `terraform.tfvars[.json]` and `*.auto.tfvars[.json]` from a
# root module's directory by itself, so one that arrived as `data` would set
# variables where nothing checks it against `vars` and `var_files`. Every
# rule refuses them in `data`, by name, in any directory. One target per
# rule and name, so each fails for its own file.

tf_library(
    name = "library_tfvars",
    srcs = ["main.tf"],
    data = ["terraform.tfvars"],
    fmt_test = False,
)

tf_library(
    name = "library_auto_tfvars",
    srcs = ["main.tf"],
    data = ["extra.auto.tfvars"],
    fmt_test = False,
)

# In a subdirectory, which would be a root module's only if something made
# it one: the listing rule can't know, so the name is refused there too.
tf_deploy(
    name = "deploy_auto_tfvars_json",
    srcs = ["main.tf"],
    data = ["env/prod.auto.tfvars.json"],
    fmt_test = False,
)

tf_library(
    name = "lib",
    srcs = ["main.tf"],
    fmt_test = False,
)

tf_test(
    name = "test_tfvars_json",
    srcs = ["main.tftest.hcl"],
    data = ["terraform.tfvars.json"],
    fmt_test = False,
    module = ":lib",
)
