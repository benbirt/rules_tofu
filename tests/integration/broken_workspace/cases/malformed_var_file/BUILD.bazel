load("@rules_tofu//tf:defs.bzl", "tf_deploy", "tf_library", "tf_test")

tf_library(
    name = "lib",
    srcs = ["main.tf"],
)

# A tf_test's var_files are not checked for duplicate keys. Passing them to
# TofuValidate makes `bazel build` fail on the malformed file.
tf_test(
    name = "test",
    srcs = ["main.tftest.hcl"],
    module = ":lib",
    var_files = ["bad.tfvars.json"],
)

# A `vars` key containing `=` must fail analysis because tofu splits
# `-var=a=b=c` at the first `=` and would set `a`.
tf_deploy(
    name = "name_with_equals",
    vars = {"a=b": "c"},
    deps = [":lib"],
)

# A `vars` key that the root module does not declare must fail TofuValidate.
# `tofu validate` accepts undeclared `-var` flags that `tofu plan` rejects.
tf_deploy(
    name = "undeclared",
    vars = {"nope": "c"},
    deps = [":lib"],
)
