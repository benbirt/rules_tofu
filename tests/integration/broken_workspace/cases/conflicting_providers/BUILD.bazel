load("@rules_tofu//tf:defs.bzl", "tf_library")
load("@rules_tofu//tf/private:provider.bzl", "tf_provider")

# Stand-in provider packages, one per supported exec platform, laid out as
# the provider repositories lay them out:
# `plugins/<address>/<version>/<os>_<arch>/<file>`. Analysing :lib checks the
# first provider for an exec-platform package before reaching the second
# provider where the version conflict is caught. Every host platform must
# therefore be present here, or the build fails first with a missing-platform
# error. The placeholder files' contents are irrelevant because analysis fails
# before any action runs.
_PLATFORMS = [
    "linux_amd64",
    "linux_arm64",
    "darwin_amd64",
    "darwin_arm64",
]

# Two tf_provider targets with the same address at different versions must
# fail the aggregate provider check when :lib depends on both.
[
    tf_provider(
        name = name,
        address = "registry.opentofu.org/hashicorp/aws",
        files = {
            "plugins/registry.opentofu.org/hashicorp/aws/{}/{}/terraform-provider-aws".format(version, platform): platform
            for platform in _PLATFORMS
        },
        version = version,
    )
    for name, version in [
        ("prov1", "5.70.0"),
        ("prov2", "5.80.0"),
    ]
]

tf_library(
    name = "lib",
    srcs = ["main.tf"],
    fmt_test = False,
    providers = [
        ":prov1",
        ":prov2",
    ],
)
