load("@rules_tofu//tf:defs.bzl", "tf_library")
load("@rules_tofu//tf/private:provider.bzl", "tf_provider")

# Stand-in provider binaries, one per supported exec platform. A tf_provider
# only materialises the binary for the exec platform, so every platform must
# be present here. Otherwise, on a host whose platform is missing, the build
# fails first with a "no <plat> entry" error instead of reaching the
# platform-independent version-conflict check under test. Neither file
# contents nor files on disk are needed because analysis fails at that check
# before any action runs.
_BINARIES = {
    "binary_linux_amd64": "linux_amd64",
    "binary_linux_arm64": "linux_arm64",
    "binary_darwin_amd64": "darwin_amd64",
    "binary_darwin_arm64": "darwin_arm64",
}

# Two tf_provider targets with the same address at different versions must
# fail the aggregate provider check when :lib depends on both.
tf_provider(
    name = "prov1",
    address = "registry.opentofu.org/hashicorp/aws",
    binaries = _BINARIES,
    version = "5.70.0",
)

tf_provider(
    name = "prov2",
    address = "registry.opentofu.org/hashicorp/aws",
    binaries = _BINARIES,
    version = "5.80.0",
)

tf_library(
    name = "lib",
    srcs = ["main.tf"],
    fmt_test = False,
    providers = [
        ":prov1",
        ":prov2",
    ],
)
