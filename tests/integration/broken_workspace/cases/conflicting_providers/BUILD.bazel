load("@rules_tofu//tf:defs.bzl", "tf_library")
load("@rules_tofu//tf/private:provider.bzl", "tf_provider")

# Stand-in provider packages, laid out as a provider repository lays its one
# out: `package/<file>`. The placeholder file's contents are irrelevant because
# analysis fails before any action runs.

# Two tf_provider targets with the same address at different versions must
# fail the aggregate provider check when :lib depends on both.
tf_provider(
    name = "prov1",
    address = "registry.opentofu.org/hashicorp/aws",
    files = ["package/terraform-provider-aws"],
    platform = "linux_amd64",
    version = "5.70.0",
)

tf_provider(
    name = "prov2",
    address = "registry.opentofu.org/hashicorp/aws",
    files = ["package/terraform-provider-aws"],
    platform = "linux_amd64",
    version = "5.80.0",
)

tf_library(
    name = "lib",
    srcs = ["main.tf"],
    fmt_test = False,
    providers = [
        ":prov1",
        ":prov2",
    ],
)

# The same version, as packages of two platforms. That is what a target gets
# when it and one of its deps are given different execution platforms: each
# target's providers are selected for its own. One plugin tree serves one
# `tofu`, so :platforms fails naming both.
tf_provider(
    name = "prov1_arm64",
    address = "registry.opentofu.org/hashicorp/aws",
    files = ["package/terraform-provider-aws"],
    platform = "linux_arm64",
    version = "5.70.0",
)

tf_library(
    name = "platforms",
    srcs = ["main.tf"],
    fmt_test = False,
    providers = [
        ":prov1",
        ":prov1_arm64",
    ],
)
