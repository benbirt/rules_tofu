# Bazel's convenience symlinks from building a nested module in its own
# directory: e2e/smoke, or one of the tests/integration sub-workspaces by hand.
# bazel-<dir>/external/rules_tofu+ points back at this repo (the module's
# local_path_override), so a later //... from the root would loop through it.
#
# Listed one by one because .bazelignore takes no patterns, and a pattern in
# REPO.bazel's ignore_directories still logs "infinite symlink expansion
# detected" while scanning them. CI's lint job checks that every directory with
# a .bazelversion has its four lines here.
e2e/smoke/bazel-bin
e2e/smoke/bazel-out
e2e/smoke/bazel-smoke
e2e/smoke/bazel-testlogs
tests/integration/broken_module/bazel-bin
tests/integration/broken_module/bazel-out
tests/integration/broken_module/bazel-broken_module
tests/integration/broken_module/bazel-testlogs
tests/integration/broken_workspace/bazel-bin
tests/integration/broken_workspace/bazel-out
tests/integration/broken_workspace/bazel-broken_workspace
tests/integration/broken_workspace/bazel-testlogs
tests/integration/custom_toolchain/bazel-bin
tests/integration/custom_toolchain/bazel-out
tests/integration/custom_toolchain/bazel-custom_toolchain
tests/integration/custom_toolchain/bazel-testlogs
tests/integration/fmt/bazel-bin
tests/integration/fmt/bazel-out
tests/integration/fmt/bazel-fmt
tests/integration/fmt/bazel-testlogs
tests/integration/lock_dependency/bazel-bin
tests/integration/lock_dependency/bazel-out
tests/integration/lock_dependency/bazel-lock_dependency
tests/integration/lock_dependency/bazel-testlogs
tests/integration/lock_update/bazel-bin
tests/integration/lock_update/bazel-out
tests/integration/lock_update/bazel-lock_update
tests/integration/lock_update/bazel-testlogs
tests/integration/module_dependency/bazel-bin
tests/integration/module_dependency/bazel-out
tests/integration/module_dependency/bazel-module_dependency
tests/integration/module_dependency/bazel-testlogs
tests/integration/run_directory/bazel-bin
tests/integration/run_directory/bazel-out
tests/integration/run_directory/bazel-run_directory
tests/integration/run_directory/bazel-testlogs
tests/integration/tf_modules/bazel-bin
tests/integration/tf_modules/bazel-out
tests/integration/tf_modules/bazel-tf_modules
tests/integration/tf_modules/bazel-testlogs
