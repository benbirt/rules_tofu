load("@gazelle//:def.bzl", "gazelle")

# gazelle:prefix github.com/benbirt/rules_tofu
gazelle(name = "gazelle")

# This target collects all of the parent workspace files needed by the broken_workspace child workspace.
filegroup(
    name = "local_repository_files",
    srcs = [
        "BUILD.bazel",
        "MODULE.bazel",
        "go.mod",
        "go.sum",
        "//tf:all_files",
        "//tf/private:all_files",
        "//tf/private/cmd/dupcheck:all_files",
        "//tf/private/cmd/internal/flags:all_files",
        "//tf/private/cmd/lockjson:all_files",
        "//tf/private/cmd/modules:all_files",
        "//tf/private/cmd/pin:all_files",
        "//tf/private/cmd/runner:all_files",
        "//tf/providers:all_files",
        "//toolchain:all_files",
    ],
    visibility = ["//:__subpackages__"],
)
