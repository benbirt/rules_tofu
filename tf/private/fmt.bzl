"""Internal fmt rules used by the `tf_library` and `tf_deploy` macros.

Not part of the public API (`//tf:defs.bzl`). Use the `fmt_test`
parameter on `tf_library` or `tf_deploy` instead.

Both rules name the files they format or check, never a directory:
`tofu fmt <dir>` reads only the directory's own files, so a `srcs` entry in
a subdirectory would be skipped and a package's files outside `srcs` would
be touched.
"""

load("//toolchain:toolchain.bzl", "TOOLCHAIN_TYPE")
load(":work_tree.bzl", "ALLOWED_SRC_EXTS", "runfiles_path")

# The extensions `tofu fmt` processes, out of ALLOWED_SRC_EXTS. Named
# explicitly, it rejects any other (.tf.json, .tofu.json, .tftpl and other
# .hcl files); in a directory it skips them.
FMT_EXTS = [".tf", ".tofu", ".tftest.hcl", ".tofutest.hcl"]

def _formattable(f):
    for ext in FMT_EXTS:
        if f.basename.endswith(ext):
            return True
    return False

def _shell_quote(s):
    return "'" + s.replace("'", "'\\''") + "'"

def _write_script(ctx, body):
    out = ctx.actions.declare_file(ctx.label.name + ".sh")
    ctx.actions.write(
        output = out,
        is_executable = True,
        content = """\
#!/usr/bin/env bash
# Generated by rules_tofu's fmt rules. Do not edit.
set -euo pipefail
""" + body,
    )
    return out

def _tf_fmt_impl(ctx):
    tofu = ctx.toolchains[TOOLCHAIN_TYPE].tofu
    workspace_name = ctx.workspace_name or "_main"
    tofu_rel = runfiles_path(workspace_name, tofu.binary)

    # Only this repository's source files can be rewritten where they are:
    # generated files live under bazel-out, and another repository's files
    # aren't in BUILD_WORKSPACE_DIRECTORY.
    files = [
        f
        for f in ctx.files.srcs
        if _formattable(f) and f.is_source and not f.short_path.startswith("../")
    ]
    if files:
        body = """\
R="${{0}}.runfiles"
W="${{BUILD_WORKSPACE_DIRECTORY:?must be invoked via 'bazel run'}}"
files=(
{files}
)
exec "$R/{tofu}" fmt "${{files[@]}}"
""".format(
            tofu = tofu_rel,
            files = "\n".join(['  "$W"/' + _shell_quote(f.short_path) for f in files]),
        )
    else:
        body = "echo '//{pkg}:{name}: no .tf, .tofu or test files of this repository in srcs; nothing to format' >&2\n".format(
            pkg = ctx.label.package,
            name = ctx.label.name,
        )

    return [DefaultInfo(
        executable = _write_script(ctx, body),
        runfiles = ctx.runfiles(files = [tofu.binary]),
    )]

tf_fmt = rule(
    implementation = _tf_fmt_impl,
    executable = True,
    attrs = {
        "srcs": attr.label_list(
            allow_files = ALLOWED_SRC_EXTS,
            doc = "Source files to format in place. Only this repository's .tf, .tofu, " +
                  ".tftest.hcl and .tofutest.hcl source files are formatted; the others are left alone.",
        ),
    },
    toolchains = [TOOLCHAIN_TYPE],
)

def _tf_fmt_check_impl(ctx):
    tofu = ctx.toolchains[TOOLCHAIN_TYPE].tofu
    workspace_name = ctx.workspace_name or "_main"
    tofu_rel = runfiles_path(workspace_name, tofu.binary)

    files = [f for f in ctx.files.srcs if _formattable(f)]
    if files:
        body = """\
R="${{TEST_SRCDIR:?must be run as a Bazel test}}"
files=(
{files}
)
exec "$R/{tofu}" fmt -check -diff "${{files[@]}}"
""".format(
            tofu = tofu_rel,
            files = "\n".join(['  "$R"/' + _shell_quote(runfiles_path(workspace_name, f)) for f in files]),
        )
    else:
        body = "echo '//{pkg}:{name}: no .tf, .tofu or test files in srcs; nothing to check' >&2\n".format(
            pkg = ctx.label.package,
            name = ctx.label.name,
        )

    return [DefaultInfo(
        executable = _write_script(ctx, body),
        runfiles = ctx.runfiles(files = [tofu.binary] + files),
    )]

tf_fmt_check_test = rule(
    implementation = _tf_fmt_check_impl,
    test = True,
    attrs = {
        "srcs": attr.label_list(
            allow_files = ALLOWED_SRC_EXTS,
            doc = "Source files to check. Only .tf, .tofu, .tftest.hcl and .tofutest.hcl files are " +
                  "checked, each by name, so files in subdirectories count and files outside `srcs` don't.",
        ),
    },
    toolchains = [TOOLCHAIN_TYPE],
)
