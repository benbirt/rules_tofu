load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "tofushow",
    srcs = ["tofushow.go"],
    importpath = "github.com/benbirt/rules_tofu/tf/private/cmd/internal/tofushow",
    visibility = ["//tf/private/cmd:__subpackages__"],
)

go_test(
    name = "tofushow_test",
    srcs = ["tofushow_test.go"],
    args = ["-tofu=$(rlocationpath //tofu)"],
    data = ["//tofu"],
    deps = [
        ":tofushow",
        "//tf/private/cmd/internal/tofushow/tofutest",
    ],
)

filegroup(
    name = "all_files",
    srcs = glob(["*"]),
    visibility = ["//:__subpackages__"],
)
