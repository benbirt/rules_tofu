load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "tfconfig",
    srcs = [
        "source.go",
        "tests.go",
        "tfconfig.go",
    ],
    importpath = "github.com/benbirt/rules_tofu/tf/private/cmd/internal/tfconfig",
    visibility = ["//tf/private/cmd:__subpackages__"],
    deps = [
        "@com_github_hashicorp_hcl_v2//:hcl",
        "@com_github_hashicorp_hcl_v2//hclparse",
        "@com_github_opentofu_registry_address_v2//:registry-address",
    ],
)

go_test(
    name = "tfconfig_test",
    srcs = [
        "source_test.go",
        "tests_test.go",
        "tfconfig_test.go",
    ],
    embed = [":tfconfig"],
)

filegroup(
    name = "all_files",
    srcs = glob(["*"]),
    visibility = ["//:__subpackages__"],
)
