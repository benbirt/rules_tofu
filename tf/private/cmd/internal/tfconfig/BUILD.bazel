load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "tfconfig",
    srcs = ["tfconfig.go"],
    importpath = "github.com/benbirt/rules_tofu/tf/private/cmd/internal/tfconfig",
    visibility = ["//tf/private/cmd:__subpackages__"],
    deps = [
        "@com_github_hashicorp_hcl_v2//:hcl",
        "@com_github_hashicorp_hcl_v2//hclparse",
    ],
)

go_test(
    name = "tfconfig_test",
    srcs = ["tfconfig_test.go"],
    embed = [":tfconfig"],
)

filegroup(
    name = "all_files",
    srcs = glob(["*"]),
    visibility = ["//:__subpackages__"],
)
