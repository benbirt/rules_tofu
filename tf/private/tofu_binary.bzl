"""Internal rule behind `@rules_tofu//tofu`.

`tofu_binary` is not exported from `//tf:defs.bzl`. `//tofu:tofu` is its only
target, and downstream modules run `@rules_tofu//tofu` rather than instantiating
this rule.
"""

load("//toolchain:toolchain.bzl", "TOOLCHAIN_TYPE")
load(":work_tree.bzl", "runfiles_path")

# The launcher runs the toolchain's `tofu` with the given arguments. It stages
# nothing, runs no `tofu init`, adds no flags and leaves the environment
# unchanged.
#
# Under `bazel run @rules_tofu//tofu`, `$0.runfiles` exists. When `//tofu` is a
# tool of another target, such as `rules_lint`'s `format_multirun`, the launcher
# sits inside that target's runfiles and `$0.runfiles` does not exist. Instead,
# `RUNFILES_DIR` or `TEST_SRCDIR` points to the runfiles. The launcher tries
# `RUNFILES_DIR`, `TEST_SRCDIR` and `$0.runfiles` in order and uses the first
# directory containing the executable binary, skipping any variable inherited
# from an unrelated program without it.
#
# `bazel run` starts a program in its runfiles tree and sets
# `BUILD_WORKING_DIRECTORY` to the directory the user ran the command in, so
# the launcher changes to that directory. When `BUILD_WORKING_DIRECTORY` is
# unset, such as when run directly or under `bazel test`, the launcher stays in
# the caller's directory.
_LAUNCHER = """\
#!/usr/bin/env bash
# Generated by rules_tofu's tofu_binary rule. Do not edit.
set -euo pipefail

tofu_path={tofu}
tofu=
for dir in "${{RUNFILES_DIR:-}}" "${{TEST_SRCDIR:-}}" "$0.runfiles"; do
  if [[ -n "$dir" && -x "$dir/$tofu_path" ]]; then
    tofu="$dir/$tofu_path"
    break
  fi
done
if [[ -z "$tofu" ]]; then
  echo "rules_tofu: cannot find the tofu binary ($tofu_path) in RUNFILES_DIR, TEST_SRCDIR or $0.runfiles; run 'bazel run @rules_tofu//tofu', run the built launcher in place under bazel-bin, or set RUNFILES_DIR or TEST_SRCDIR when invoking it as a tool" >&2
  exit 1
fi

# Make the binary path absolute before changing directory.
[[ "$tofu" == /* ]] || tofu="$PWD/$tofu"
if [[ -n "${{BUILD_WORKING_DIRECTORY:-}}" ]]; then
  cd "$BUILD_WORKING_DIRECTORY"
fi
exec "$tofu" "$@"
"""

def _shell_quote(s):
    return "'" + s.replace("'", "'\\''") + "'"

def _tofu_binary_impl(ctx):
    tofu = ctx.toolchains[TOOLCHAIN_TYPE].tofu
    out = ctx.actions.declare_file(ctx.label.name + ".sh")
    ctx.actions.write(
        output = out,
        is_executable = True,
        content = _LAUNCHER.format(
            tofu = _shell_quote(runfiles_path(ctx.workspace_name or "_main", tofu.binary)),
        ),
    )
    return [DefaultInfo(
        executable = out,
        runfiles = ctx.runfiles(files = [tofu.binary]),
    )]

tofu_binary = rule(
    implementation = _tofu_binary_impl,
    executable = True,
    doc = "Runs the toolchain's `tofu` binary with the given arguments, " +
          "changing to `BUILD_WORKING_DIRECTORY` when set.",
    toolchains = [TOOLCHAIN_TYPE],
)
