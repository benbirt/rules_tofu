"""Internal rule behind `@rules_tofu//tofu`, the runnable pinned `tofu`.

Not part of `//tf:defs.bzl`: `//tofu:tofu` is its only target, and downstream
modules run that target rather than declaring their own.
"""

load("//toolchain:toolchain.bzl", "TOOLCHAIN_TYPE")
load(":work_tree.bzl", "runfiles_path")

# The launcher is plain `tofu`: it stages nothing, runs no `tofu init`, adds
# no flags and leaves the environment alone.
#
# Runfiles: `$0.runfiles` exists under `bazel run @rules_tofu//tofu`, but not
# when this is a tool of another target (rules_lint's `format_multirun`),
# where the launcher sits inside that target's runfiles and RUNFILES_DIR or
# TEST_SRCDIR says where they are. Each candidate is checked for the binary,
# so a variable left over from an unrelated program is skipped, not believed.
#
# Directory: `bazel run` starts every program in its runfiles tree and passes
# the directory the user typed the command in as BUILD_WORKING_DIRECTORY.
# Without it (run directly, or under `bazel test`) the caller's directory is
# already the right one.
_LAUNCHER = """\
#!/usr/bin/env bash
# Generated by rules_tofu's //tofu. Do not edit.
set -euo pipefail

tofu_path={tofu}
tofu=
for dir in "${{RUNFILES_DIR:-}}" "${{TEST_SRCDIR:-}}" "$0.runfiles"; do
  if [[ -n "$dir" && -x "$dir/$tofu_path" ]]; then
    tofu="$dir/$tofu_path"
    break
  fi
done
if [[ -z "$tofu" ]]; then
  echo "$0: cannot find the tofu binary ($tofu_path) in RUNFILES_DIR, TEST_SRCDIR or $0.runfiles; run 'bazel run @rules_tofu//tofu', or make this a tool of a target that sets one of those variables" >&2
  exit 1
fi

# Absolute, because the directory is about to change.
[[ "$tofu" == /* ]] || tofu="$PWD/$tofu"
if [[ -n "${{BUILD_WORKING_DIRECTORY:-}}" ]]; then
  cd "$BUILD_WORKING_DIRECTORY"
fi
exec "$tofu" "$@"
"""

def _shell_quote(s):
    return "'" + s.replace("'", "'\\''") + "'"

def _tofu_binary_impl(ctx):
    tofu = ctx.toolchains[TOOLCHAIN_TYPE].tofu
    out = ctx.actions.declare_file(ctx.label.name + ".sh")
    ctx.actions.write(
        output = out,
        is_executable = True,
        content = _LAUNCHER.format(
            tofu = _shell_quote(runfiles_path(ctx.workspace_name or "_main", tofu.binary)),
        ),
    )
    return [DefaultInfo(
        executable = out,
        runfiles = ctx.runfiles(files = [tofu.binary]),
    )]

tofu_binary = rule(
    implementation = _tofu_binary_impl,
    executable = True,
    doc = "Runs the toolchain's `tofu` with the arguments given, in the directory " +
          "`bazel run` was started from.",
    toolchains = [TOOLCHAIN_TYPE],
)
