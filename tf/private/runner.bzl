"""`tf_runner` rule.

Emits an executable that runs `tofu init && tofu <plan|apply|destroy>` for a
deploy. The executable is a small shell wrapper that execs the Go runner binary
with all configuration passed as explicit CLI flags, avoiding template
substitutions in the runner and runfiles boilerplate in bash.

It is an ordinary Bazel-built executable: `bazel run` works, and so does
running the built file from any directory. It finds everything from its own
location, with its runfiles tree beside it and the deploy's state directory in
the same output directory, never from the checkout or
`BUILD_WORKSPACE_DIRECTORY`.
"""

load("//toolchain:toolchain.bzl", "TOOLCHAIN_TYPE")
load(":providers.bzl", "TfDeployInfo")
load(":work_tree.bzl", "runfiles_path")

_RUNNER_BIN_LABEL = "//tf/private/cmd/runner:runner"

def _tf_runner_impl(ctx):
    deploy = ctx.attr.deploy[TfDeployInfo]
    tofu = ctx.toolchains[TOOLCHAIN_TYPE].tofu
    runner_bin = ctx.attr._runner_bin[DefaultInfo].files_to_run.executable
    workspace_name = ctx.workspace_name or "_main"

    runner_rel = runfiles_path(workspace_name, runner_bin)
    tofu_rel = runfiles_path(workspace_name, tofu.binary)

    # The deploy's outputs are declared in its package, so the work tree root
    # in runfiles is `<package in runfiles>/<name>.work` and the plugin tree
    # its sibling `<name>.plugins`. The package's runfiles directory is the
    # one holding the deploy's module manifest, `<name>.modules.json`, which
    # also covers a deploy in another repository.
    package_rel = runfiles_path(workspace_name, deploy.modules_manifest).rpartition("/")[0]
    work_tree_root = "{}/{}.work".format(package_rel, ctx.attr.deploy.label.name)
    plugin_tree_root = "{}/{}.plugins".format(package_rel, ctx.attr.deploy.label.name)

    var_file_flags = "".join([
        '    --var-file="$R/{root}/{p}" \\\n'.format(root = work_tree_root, p = p)
        for p in deploy.var_file_relpaths
    ])

    # Emitted as a bare flag only when the deploy opts in: Go's flag package
    # reads a valueless boolean flag as true, and omitting the line entirely
    # leaves the runner's own `false` default in place.
    ephemeral_state_flag = ""
    if deploy.allow_ephemeral_state:
        ephemeral_state_flag = "    --allow-ephemeral-state \\\n"

    lock_flag = ""
    if deploy.lock:
        lock_flag = '    --lock-file="$R/{}" \\\n'.format(runfiles_path(workspace_name, deploy.lock))

    out = ctx.actions.declare_file(ctx.label.name + ".sh")

    # State lives at the deploy's `$(RULEDIR)/<name>.rules_tofu-state`, that is,
    # `bazel-out/<config>/bin/<pkg>/<name>.rules_tofu-state`, which the
    # standard `bazel-*` gitignore covers and `bazel clean` wipes. The launcher
    # is declared in that same directory, so at run time it is the launcher's
    # own directory: one state directory for the deploy's .plan, .apply and
    # .destroy, found without the checkout.
    if out.dirname != deploy.modules_manifest.dirname:
        fail("tf_runner {} must be declared in its deploy's package: its launcher is in {}, the deploy's outputs in {}".format(
            ctx.label,
            out.dirname,
            deploy.modules_manifest.dirname,
        ))

    # Bazel's output tree, `bazel-out`, is the first segment of the launcher's
    # path, so it is that many directories above the launcher. The runner
    # treats a `backend "local"` path inside it as ephemeral state.
    output_root_rel = "/".join([".."] * (len(out.dirname.split("/")) - 1))

    ctx.actions.write(
        output = out,
        is_executable = True,
        content = """\
#!/usr/bin/env bash
# Generated by rules_tofu's tf_runner rule. Do not edit.
set -euo pipefail
# The launcher's own directory, physical and absolute however it was invoked
# (`bazel run` uses an absolute path, a direct run usually a relative one).
D="$(cd "$(dirname "$0")" && pwd -P)"
R="$D/${{0##*/}}.runfiles"
if [[ ! -d "$R" ]]; then
    echo "rules_tofu: no runfiles tree at $R: run this launcher where Bazel built it (bazel run, or its path under bazel-bin), not a copy of or a link to it" >&2
    exit 1
fi
exec "$R/{runner}" \\
    --tofu="$R/{tofu}" \\
    --work-tree="$R/{work_tree}" \\
    --package-dir="{pkg}" \\
    --plugin-dir="$R/{plugin_tree}" \\
    --modules-manifest="$R/{modules_manifest}" \\
    --state-dir="$D/{state_dir_name}" \\
    --output-root="$D/{output_root_rel}" \\
    --command="{command}" \\
{ephemeral_state_flag}{lock_flag}{var_file_flags}    -- "$@"
""".format(
            runner = runner_rel,
            tofu = tofu_rel,
            work_tree = work_tree_root,
            plugin_tree = plugin_tree_root,
            modules_manifest = runfiles_path(workspace_name, deploy.modules_manifest),
            pkg = deploy.package_dir,
            state_dir_name = ctx.attr.deploy.label.name + ".rules_tofu-state",
            output_root_rel = output_root_rel,
            command = ctx.attr.command,
            ephemeral_state_flag = ephemeral_state_flag,
            lock_flag = lock_flag,
            var_file_flags = var_file_flags,
        ),
    )

    runfiles = ctx.runfiles(
        files = [tofu.binary, deploy.modules_manifest] + ([deploy.lock] if deploy.lock else []) + deploy.work_tree_files.to_list(),
    ).merge(ctx.attr._runner_bin[DefaultInfo].default_runfiles)

    return [DefaultInfo(executable = out, runfiles = runfiles)]

tf_runner = rule(
    implementation = _tf_runner_impl,
    executable = True,
    attrs = {
        "deploy": attr.label(
            mandatory = True,
            providers = [TfDeployInfo],
        ),
        "command": attr.string(
            mandatory = True,
            values = ["plan", "apply", "destroy"],
        ),
        "_runner_bin": attr.label(
            default = _RUNNER_BIN_LABEL,
            executable = True,
            cfg = "exec",
        ),
    },
    toolchains = [TOOLCHAIN_TYPE],
)
