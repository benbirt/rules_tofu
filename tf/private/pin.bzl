"""`tf_pin` rule: `bazel run @tf_providers//:pin`.

Instantiated by the `tf_providers` extension in the hub repo it creates for
`tf_providers.from_lock`. Running it rewrites the lock with
`tofu providers lock`, using the toolchain's tofu, against the
`required_providers` of every directory in the workspace (see
//tf/private/cmd/pin).
"""

load("//toolchain:toolchain.bzl", "TOOLCHAIN_TYPE")
load(":work_tree.bzl", "runfiles_path")

visibility(["public"])

def _tf_pin_impl(ctx):
    tofu = ctx.toolchains[TOOLCHAIN_TYPE].tofu
    pin_bin = ctx.attr._pin_bin[DefaultInfo].files_to_run.executable
    workspace_name = ctx.workspace_name or "_main"
    out = ctx.actions.declare_file(ctx.label.name + ".sh")
    ctx.actions.write(
        output = out,
        is_executable = True,
        content = """\
#!/usr/bin/env bash
# Generated by rules_tofu's tf_pin rule. Do not edit.
set -euo pipefail
R="${{0}}.runfiles"
exec "$R/{pin}" \\
    --tofu="$R/{tofu}" \\
    --lock-dir="{lock_dir}" \\
{platform_flags}{exclude_flags}    -- "$@"
""".format(
            pin = runfiles_path(workspace_name, pin_bin),
            tofu = runfiles_path(workspace_name, tofu.binary),
            lock_dir = ctx.attr.lock_dir,
            platform_flags = "".join(["    --platform={} \\\n".format(p) for p in ctx.attr.platforms]),
            exclude_flags = "".join(["    --exclude-source={} \\\n".format(s) for s in ctx.attr.exclude_sources]),
        ),
    )
    runfiles = ctx.runfiles(files = [tofu.binary]).merge(ctx.attr._pin_bin[DefaultInfo].default_runfiles)
    return [DefaultInfo(executable = out, runfiles = runfiles)]

tf_pin = rule(
    implementation = _tf_pin_impl,
    attrs = {
        "lock_dir": attr.string(
            doc = "Workspace-relative directory of the `.terraform.lock.hcl`.",
        ),
        "exclude_sources": attr.string_list(
            doc = "`<namespace>/<name>` of providers the root module pins with tags, left out of the lock.",
        ),
        "platforms": attr.string_list(
            doc = "`<os>_<arch>` platforms to lock for unless `-platform=` arguments are passed.",
        ),
        "_pin_bin": attr.label(
            default = "//tf/private/cmd/pin",
            executable = True,
            cfg = "target",
        ),
    },
    executable = True,
    toolchains = [TOOLCHAIN_TYPE],
    doc = "Regenerates the workspace's `.terraform.lock.hcl` with `tofu providers lock`.",
)
