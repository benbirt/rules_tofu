"""`tf_pin` rule: `bazel run @tf_providers//:pin`.

Instantiated by the `tf_providers` extension in the hub repo it creates for
`tf_providers.from_lock`. Running it executes `tofu providers lock` with the
toolchain's tofu in the lock's directory, so the lock is written by the
same tool, from the same `required_providers` (the `.tf` files beside the
lock), as when Renovate or Dependabot update it.
"""

load("//toolchain:toolchain.bzl", "TOOLCHAIN_TYPE")
load(":work_tree.bzl", "runfiles_path")

visibility(["public"])

def _tf_pin_impl(ctx):
    tofu = ctx.toolchains[TOOLCHAIN_TYPE].tofu
    out = ctx.actions.declare_file(ctx.label.name + ".sh")
    ctx.actions.write(
        output = out,
        is_executable = True,
        content = """\
#!/usr/bin/env bash
# Generated by rules_tofu's tf_pin rule. Do not edit.
set -euo pipefail
TOFU="${{0}}.runfiles/{tofu}"
LOCK_DIR="${{BUILD_WORKSPACE_DIRECTORY:?must be invoked via 'bazel run'}}/{lock_dir}"
# Lock for the default platforms unless the caller names its own.
platforms=({platforms})
for arg in "$@"; do
    case "$arg" in
        -platform=* | --platform=*) platforms=() ;;
    esac
done
# `tofu providers lock` keeps the versions an existing lock selected and has
# no -upgrade, so lock a copy of the directory's configuration from scratch.
SCRATCH=$(mktemp -d "${{TMPDIR:-/tmp}}/rules_tofu-pin-XXXXXX")
trap 'rm -rf "$SCRATCH"' EXIT
found=
for f in "$LOCK_DIR"/*.tf "$LOCK_DIR"/*.tf.json; do
    if [ -f "$f" ]; then
        cp "$f" "$SCRATCH"/
        found=1
    fi
done
if [ -z "$found" ]; then
    echo "rules_tofu: no .tf files in $LOCK_DIR to read required_providers from." \
         "Add a versions.tf there that pins each provider." 1>&2
    exit 1
fi
# The `+` form: bash 3.2 (macOS) treats an empty array as unset under `set -u`.
"$TOFU" -chdir="$SCRATCH" providers lock ${{platforms[@]+"${{platforms[@]}}"}} "$@"
cp "$SCRATCH/.terraform.lock.hcl" "$LOCK_DIR/.terraform.lock.hcl"
echo "rules_tofu: wrote $LOCK_DIR/.terraform.lock.hcl" 1>&2
""".format(
            tofu = runfiles_path(ctx.workspace_name or "_main", tofu.binary),
            lock_dir = ctx.attr.lock_dir,
            platforms = " ".join(["-platform=" + p for p in ctx.attr.platforms]),
        ),
    )
    return [DefaultInfo(
        executable = out,
        runfiles = ctx.runfiles(files = [tofu.binary]),
    )]

tf_pin = rule(
    implementation = _tf_pin_impl,
    attrs = {
        "lock_dir": attr.string(
            doc = "Workspace-relative directory of the `.terraform.lock.hcl`.",
        ),
        "platforms": attr.string_list(
            doc = "`<os>_<arch>` platforms to lock for unless `-platform=` arguments are passed.",
        ),
    },
    executable = True,
    toolchains = [TOOLCHAIN_TYPE],
    doc = "Regenerates the workspace's `.terraform.lock.hcl` with `tofu providers lock`.",
)
