"""Providers exchanged between rules_tofu rules.

These providers are the typed channel by which the dep graph composes:
the `tf_library` rule emits a `TfLibraryInfo` carrying its
own files plus its transitive deps' files; downstream libraries and the
root `tf_deploy` consume it to assemble the full input set, and
the runner rule reads `TfDeployInfo` for the deploy's runfiles set,
its package directory, and var-file paths — the inputs it needs to
invoke `tofu` against the materialized work tree.
"""

visibility(["public"])

# Carried by a `tf_provider` target generated by the
# `@rules_tofu//tf/providers:extensions.bzl` extension. The deploy rule
# picks `binaries[exec_platform_key]` and symlinks it into a sibling plugin
# tree at the canonical
# `<host>/<namespace>/<name>/<version>/<os>_<arch>/<filename>` path.
TfProviderInfo = provider(
    doc = "A vendored OpenTofu/Terraform provider plugin binary, per platform.",
    fields = {
        "address": "string: the canonical provider address, e.g. \"registry.opentofu.org/hashicorp/aws\".",
        "version": "string: the provider version, e.g. \"5.70.0\".",
        "binaries": "dict[string -> File]: provider binary keyed by `<os>_<arch>` platform key.",
        "package_files": "dict[string -> list[struct(path, file)]]: the rest of each platform's unpacked zip, " +
                         "keyed like `binaries`; `path` is relative to the `<os>_<arch>` directory.",
        "lock": "File or None: the `.terraform.lock.hcl` the provider was pinned by (`tf_providers.from_lock`).",
    },
)

# An entry in `transitive_files` is a `struct(path, file)`, where `path` is
# the path at which the file should appear in the materialized working tree:
# workspace-relative for the main repository, `external/<repo>/...` for others
# (see `work_tree_path`).
#
# A library with `module_source` is a module that HCL calls by that address
# rather than by a relative path: `module` is then a
# `struct(label, source, version, dir)`, where `dir` is the library's
# directory in the work tree, and `modules` carries it to the roots that
# write the call into their `.terraform/modules/modules.json`.
TfLibraryInfo = provider(
    doc = "Carries the .tf and data files contributed by a tf_library and all its transitive library deps.",
    fields = {
        "transitive_files": "depset[struct(path, file)] of .tf and arbitrary data files across the dep graph.",
        "providers": "depset[TfProviderInfo]: providers contributed by this library and its transitive deps.",
        "module": "struct(label, source, version, dir) or None: this library's `module_source`, if it sets one.",
        "modules": "depset[struct(label, source, version, dir)]: `module` of this library and its transitive deps.",
    },
)

# The materialized work tree is a directory output of `_tf_deploy`
# rooted at `bazel-bin/<package>/<name>.work/`. Every transitive .tf file
# (plus the generated rules_tofu.auto.tfvars.json) appears under that root
# at its workspace-relative path.
TfDeployInfo = provider(
    doc = "Carries everything a runner needs to execute `tofu` against a root deploy.",
    fields = {
        "work_tree_files": "depset[File]: every file inside the work tree and the sibling plugin tree " +
                           "(so runfiles include them).",
        "package_dir": "string: workspace-relative directory the runner cd's into before running tofu.",
        "var_file_relpaths": "list[string]: workspace-relative paths of -var-file inputs, in declaration order.",
        "lock": "File or None: the `.terraform.lock.hcl` to place next to the configuration before `tofu init`.",
        "modules_manifest": "File: the `.terraform/modules/modules.json` to place next to the configuration " +
                            "before `tofu init -get=false`.",
        "allow_ephemeral_state": "bool: whether this deploy opts in to local, disposable state. When False " +
                                 "(the default) the runner refuses `apply`/`destroy` unless the deploy declares " +
                                 "a `backend`/`cloud` block, because local state lives under bazel-bin and is " +
                                 "wiped by `bazel clean`. `plan` is never gated.",
    },
)
