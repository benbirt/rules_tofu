"""Bazel providers exchanged between `rules_tofu` rules.

`TfProviderInfo` carries a vendored OpenTofu provider's per-platform packages
and optional lock file. `TfLibraryInfo` propagates a `tf_library`'s files,
providers and `module_source` metadata to downstream libraries, deploys and
tests. `TfDeployInfo` gives the deploy's `.plan`, `.apply` and `.destroy`
runners and any `tf_test` targeting the deploy everything needed to stage and
run `tofu`.
"""

visibility(["public"])

# Carried by a `tf_provider` target generated by
# `@rules_tofu//tf/providers:extensions.bzl`. materialize_plugin_tree picks the
# exec platform's binary and package_files and symlinks them into a sibling
# plugin tree under `<host>/<namespace>/<name>/<version>/<os>_<arch>/`.
TfProviderInfo = provider(
    doc = "A vendored OpenTofu provider's per-platform packages and optional lock file.",
    fields = {
        "address": "string: the canonical provider address, e.g. \"registry.opentofu.org/hashicorp/aws\".",
        "version": "string: the provider version, e.g. \"5.70.0\".",
        "binaries": "dict[string -> File]: provider binary keyed by `<os>_<arch>` platform key.",
        "package_files": "dict[string -> list[struct(path, file)]]: the rest of each platform's unpacked zip, " +
                         "keyed like `binaries`; `path` is relative to the `<os>_<arch>` directory.",
        "lock": "File or None: the `.terraform.lock.hcl` the provider was pinned by (`tf_providers.from_lock`).",
    },
)

# An entry in `transitive_files` is a `struct(path, file)`, where `path` is
# the path at which the file should appear in the materialised work tree:
# workspace-relative for the main repository, `external/<repo>/...` for others
# (see `work_tree_path`).
#
# A library with `module_source` is a module that HCL calls by that address
# rather than by a relative path: `module` is then a
# `struct(label, source, version, dir)`, where `dir` is the library's
# directory in the work tree, and `modules` carries it to the roots that
# write the call into their `.terraform/modules/modules.json`.
TfLibraryInfo = provider(
    doc = "Transitive files, providers and module metadata of a `tf_library`.",
    fields = {
        "transitive_files": "depset[struct(path, file)]: configuration and data files of this library and its transitive deps.",
        "providers": "depset[TfProviderInfo]: providers contributed by this library and its transitive deps.",
        "module": "struct(label, source, version, dir) or None: this library's `module_source`, if it sets one.",
        "modules": "depset[struct(label, source, version, dir)]: `module` of this library and its transitive deps.",
        "packages": "depset[string]: the work-tree directory of the package of this library and of its " +
                    "transitive deps, so a directory can be traced to the library that owns it.",
        "package_dir": "string: the work-tree directory of this library's package, `<workspace_root>/<package>`; " +
                       "the root module directory when the library is tested. Carried here so a `tf_test` " +
                       "reads it from the provider, which an `alias` passes through unchanged.",
    },
)

# tf_deploy symlinks every work-tree input under
# `bazel-bin/<package>/<name>.work/` at its work_tree_path and writes
# rules_tofu.auto.tfvars.json beside the root module's configuration.
TfDeployInfo = provider(
    doc = "Inputs and metadata of a `tf_deploy` for its runner targets and `tf_test`.",
    fields = {
        "work_tree_files": "depset[File]: every file in the work tree and the sibling plugin tree for runfiles.",
        "package_dir": "string: work-tree-relative directory of the root module where the runner runs `tofu`.",
        "var_file_relpaths": "list[string]: work-tree-relative paths of `-var-file` inputs, in declaration order.",
        "lock": "File or None: the `.terraform.lock.hcl` to place next to the configuration before `tofu init`.",
        "modules_manifest": "File: the `.terraform/modules/modules.json` to place next to the configuration " +
                            "before `tofu init -get=false`.",
        "allow_ephemeral_state": "bool: whether this deploy opts in to local, disposable state. When False " +
                                 "by default, the runner refuses `apply`/`destroy` unless the deploy declares " +
                                 "a backend that keeps state outside Bazel's output tree, because state under " +
                                 "`bazel-bin` is wiped by `bazel clean`. `plan` is never gated.",
        "transitive_files": "depset[struct(path, file)]: the deploy's own files, its `var_files` and the files of " +
                            "its transitive library deps, un-materialised, so a `tf_test` can build a work tree of them.",
        "providers": "depset[TfProviderInfo]: providers of the deploy and its transitive deps.",
        "modules": "depset[struct(label, source, version, dir)]: `module` of the deploy's transitive deps.",
        "packages": "depset[string]: the work-tree directory of the deploy's package and of its transitive " +
                    "deps' (see TfLibraryInfo).",
        "tfvars_content": "string: the `rules_tofu.auto.tfvars.json` rendered from `vars`.",
        "var_files": "list[File]: the `var_files`, in declaration order.",
    },
)
