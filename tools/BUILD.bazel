# Maintainer tools. Dev-only: this package references dev dependencies
# (aspect_rules_lint, buildifier_prebuilt, rules_shell, the cosign downloads)
# and is excluded from the release tarball by release_prep.sh.

load("@aspect_rules_lint//format:defs.bzl", "format_multirun")
load("@buildifier_prebuilt//:rules.bzl", "buildifier")
load("@go_host_compatible_sdk_label//:defs.bzl", "HOST_COMPATIBLE_SDK")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

# Formats git-tracked Go, Starlark, .tf and .tfvars files via rules_lint:
# `bazel run //tools:format` rewrites files; `:format.check` checks them.
format_multirun(
    name = "format",
    go = HOST_COMPATIBLE_SDK.same_package_label("bin/gofmt"),
    starlark = "@buildifier_prebuilt//:buildifier",
    terraform = "//tofu",
)

# Lints every Starlark file under the workspace via `bazel run //tools:lint`,
# including nested workspaces and untracked files; fails on any lint warning
# or formatting diff. Excludes `.git` so refs like `fix/BUILD` are not matched.
# Suppress deliberate warnings inline with `# buildifier: disable=<warning>`
# and a reason; buildifier reads no ignore file.
buildifier(
    name = "lint",
    exclude_patterns = ["./.git/*"],
    lint_mode = "warn",
    mode = "check",
)

# cosign for the host, from the sigstore/cosign release pinned in MODULE.bazel.
alias(
    name = "cosign",
    actual = select(
        {
            ":linux_amd64": "@cosign_linux_amd64//file",
            ":linux_arm64": "@cosign_linux_arm64//file",
            ":darwin_amd64": "@cosign_darwin_amd64//file",
            ":darwin_arm64": "@cosign_darwin_arm64//file",
        },
        no_match_error = "cosign is pinned for Linux and macOS on amd64/arm64 only; add the platform to MODULE.bazel and tools/BUILD.bazel",
    ),
)

[
    config_setting(
        name = name,
        constraint_values = [
            os,
            cpu,
        ],
    )
    for name, os, cpu in [
        ("linux_amd64", "@platforms//os:linux", "@platforms//cpu:x86_64"),
        ("linux_arm64", "@platforms//os:linux", "@platforms//cpu:aarch64"),
        ("darwin_amd64", "@platforms//os:macos", "@platforms//cpu:x86_64"),
        ("darwin_arm64", "@platforms//os:macos", "@platforms//cpu:aarch64"),
    ]
]

# Pins a new OpenTofu release in //toolchain:versions.bzl from its signed
# SHA256SUMS: `bazel run //tools:update_versions -- [--default] <version>`.
sh_binary(
    name = "update_versions",
    srcs = ["update_versions.sh"],
    data = [":cosign"],
    env = {"COSIGN": "$(rlocationpath :cosign)"},
    deps = ["@bazel_tools//tools/bash/runfiles"],
)
