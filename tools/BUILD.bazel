# Maintainer tools. Dev-only: this package references dev dependencies
# (bazel_style, rules_shell and the cosign downloads) and is excluded from the
# release tarball by release_prep.sh.

load("@bazel_style//:defs.bzl", "style")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

# `bazel run //tools:format` formats git-tracked files, `:format.check` checks
# them, and `:lint` lints every Starlark file under the workspace, including
# nested workspaces and untracked files. Formatters and settings come from
# benbirt/bazel-style, except `terraform`: this repository overrides it with its
# own `//tofu` so `.tf` and `.tfvars` files are formatted with `tofu fmt` rather
# than bazel_style's default `terraform fmt`.
style(terraform = "//tofu")

# cosign for the host, from the sigstore/cosign release pinned in MODULE.bazel.
alias(
    name = "cosign",
    actual = select(
        {
            ":linux_amd64": "@cosign_linux_amd64//file",
            ":linux_arm64": "@cosign_linux_arm64//file",
            ":darwin_amd64": "@cosign_darwin_amd64//file",
            ":darwin_arm64": "@cosign_darwin_arm64//file",
        },
        no_match_error = "cosign is pinned for Linux and macOS on amd64/arm64 only; add the platform to MODULE.bazel and tools/BUILD.bazel",
    ),
)

[
    config_setting(
        name = name,
        constraint_values = [
            os,
            cpu,
        ],
    )
    for name, os, cpu in [
        ("linux_amd64", "@platforms//os:linux", "@platforms//cpu:x86_64"),
        ("linux_arm64", "@platforms//os:linux", "@platforms//cpu:aarch64"),
        ("darwin_amd64", "@platforms//os:macos", "@platforms//cpu:x86_64"),
        ("darwin_arm64", "@platforms//os:macos", "@platforms//cpu:aarch64"),
    ]
]

# Pins one or more OpenTofu releases in //toolchain:versions.bzl from their
# signed SHA256SUMS:
# `bazel run //tools:update_versions -- [--default] <version>...`.
sh_binary(
    name = "update_versions",
    srcs = ["update_versions.sh"],
    data = [":cosign"],
    env = {"COSIGN": "$(rlocationpath :cosign)"},
    deps = ["@bazel_tools//tools/bash/runfiles"],
)
