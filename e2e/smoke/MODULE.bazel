"""Minimal downstream module that consumes rules_tofu as the README quick-start
documents. This is the BCR presubmit test module: it checks that the published
archive builds and that tf_library, tf_deploy and tf_test work for a real
consumer, offline and without credentials.

local_path_override points at the repo root so the same module also runs
locally via `cd e2e/smoke && bazel build //... && bazel test //...`. Under BCR
presubmit the override stays active but is equivalent: presubmit unpacks the
module source from the registry entry (release archive plus any BCR patches)
and runs this test module from e2e/smoke inside that unpacked tree, so ../..
resolves to the exact files the registry serves.
"""

bazel_dep(name = "rules_tofu", version = "0.0.0")
local_path_override(
    module_name = "rules_tofu",
    path = "../..",
)

tofu = use_extension("@rules_tofu//toolchain:extensions.bzl", "tofu")
use_repo(tofu, "tofu_toolchains")
