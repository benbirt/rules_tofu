load("@rules_tofu//tf:defs.bzl", "tf_deploy", "tf_library", "tf_test")

package(default_visibility = ["//visibility:public"])

tf_library(
    name = "greet_lib",
    srcs = ["main.tf"],
)

tf_deploy(
    name = "smoke",
    vars = {
        "name": "bcr",
    },
    deps = [":greet_lib"],
)

# The deploy's `tofu test` tests, run offline by `bazel test`.
tf_test(
    name = "smoke_test",
    srcs = ["tests/smoke.tftest.hcl"],
    module = ":smoke",
)

# This alias makes `bazel build //...` in this module build `@rules_tofu//tofu`.
# Because the BCR presubmit builds this module against the published archive,
# building `:tofu` checks that the archive ships the `tofu` package.
alias(
    name = "tofu",
    actual = "@rules_tofu//tofu",
)
