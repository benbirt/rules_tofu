# Per-workspace settings shared across contributors.
# Session-specific overrides (e.g. proxy creds, registry mirrors) live in
# `.bazelrc.local`, which is gitignored.
try-import %workspace%/.bazelrc.local

# Hide packages belonging to nested child workspaces (the intentionally broken
# integration-test cases and the e2e/smoke BCR test module) from the root
# package universe. The tool auto-discovers every nested workspace, so these
# two lines are the single place all of them are excluded. To update, execute
# `bazel run @rules_bazel_integration_test//tools:update_deleted_packages`
build --deleted_packages=e2e/smoke,tests/integration/broken_module/cases/duplicate_root_version,tests/integration/broken_workspace/cases/auto_tfvars_conflict,tests/integration/broken_workspace/cases/conflicting_providers,tests/integration/broken_workspace/cases/duplicate_vars,tests/integration/broken_workspace/cases/ephemeral_state_refused,tests/integration/broken_workspace/cases/external_module_ref,tests/integration/broken_workspace/cases/lock_file_smuggled,tests/integration/broken_workspace/cases/malformed_var_file,tests/integration/broken_workspace/cases/missing_provider,tests/integration/broken_workspace/cases/provider_repo_private,tests/integration/broken_workspace/cases/registry_sha256_mismatch,tests/integration/broken_workspace/cases/stale_lock,tests/integration/broken_workspace/cases/validate_fails,tests/integration/broken_workspace/lock,tests/integration/custom_toolchain,tests/integration/lock_dependency/lib_module,tests/integration/lock_update
query --deleted_packages=e2e/smoke,tests/integration/broken_module/cases/duplicate_root_version,tests/integration/broken_workspace/cases/auto_tfvars_conflict,tests/integration/broken_workspace/cases/conflicting_providers,tests/integration/broken_workspace/cases/duplicate_vars,tests/integration/broken_workspace/cases/ephemeral_state_refused,tests/integration/broken_workspace/cases/external_module_ref,tests/integration/broken_workspace/cases/lock_file_smuggled,tests/integration/broken_workspace/cases/malformed_var_file,tests/integration/broken_workspace/cases/missing_provider,tests/integration/broken_workspace/cases/provider_repo_private,tests/integration/broken_workspace/cases/registry_sha256_mismatch,tests/integration/broken_workspace/cases/stale_lock,tests/integration/broken_workspace/cases/validate_fails,tests/integration/broken_workspace/lock,tests/integration/custom_toolchain,tests/integration/lock_dependency/lib_module,tests/integration/lock_update
