load("@rules_tofu//tf:defs.bzl", "tf_deploy", "tf_library")

# OpenTofu tests for both targets are in tests/BUILD.bazel.
package(default_visibility = ["//visibility:public"])

tf_library(
    name = "greet_lib",
    srcs = ["main.tf"],
)

# This is a demo, so it keeps disposable state under bazel-bin; a real deploy
# declares a remote backend instead.
tf_deploy(
    name = "hello",
    allow_ephemeral_state = True,
    vars = {
        "name": "world",
    },
    deps = [":greet_lib"],
)
