load("@rules_tofu//tf:defs.bzl", "tf_deploy", "tf_library")

# Both targets' `tofu test` tests are in tests/ (see tests/BUILD.bazel).
package(default_visibility = ["//visibility:public"])

tf_library(
    name = "greet_lib",
    srcs = ["main.tf"],
)

# A demo deploy: its state is disposable, so it opts in to local state under
# bazel-bin rather than declaring a remote backend.
tf_deploy(
    name = "hello",
    allow_ephemeral_state = True,
    vars = {
        "name": "world",
    },
    deps = [":greet_lib"],
)
