load("@rules_tofu//tf:defs.bzl", "tf_test")

# greet_test runs `tofu test` against greet_lib offline, with network access
# blocked in the sandbox. Its run blocks load a helper module from deps. srcs
# mixes .tftest.hcl with OpenTofu's .tofutest.hcl extension.
tf_test(
    name = "greet_test",
    srcs = [
        "greet.tftest.hcl",
        "subject.tofutest.hcl",
    ],
    module = "//examples/hello:greet_lib",
    deps = ["//examples/hello/tests/subject"],
)

# This target tests the hello deploy. The deploy's vars bind name, so the test
# file sets nothing.
tf_test(
    name = "hello_test",
    srcs = ["hello.tftest.hcl"],
    module = "//examples/hello:hello",
)

# module on tf_test may be an alias. The root module is still examples/hello,
# not this package.
alias(
    name = "greet_alias",
    actual = "//examples/hello:greet_lib",
)

tf_test(
    name = "greet_alias_test",
    srcs = ["greet.tftest.hcl"],
    # greet_test already checks greet.tftest.hcl's formatting.
    fmt_test = False,
    module = ":greet_alias",
    deps = ["//examples/hello/tests/subject"],
)
