load("@rules_tofu//tf:defs.bzl", "tf_library")

# versions.tf holds exact provider version pins beside .terraform.lock.hcl,
# which MODULE.bazel loads with tf_providers.from_lock. Building this target
# checks that the lock satisfies versions.tf. Run `bazel run @tf_providers//:pin`
# to update the lock after editing provider constraints.
tf_library(
    name = "versions",
    srcs = ["versions.tf"],
    providers = ["@tf_providers//hashicorp/null"],
)
