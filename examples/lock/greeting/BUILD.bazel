load("@rules_tofu//tf:defs.bzl", "tf_deploy", "tf_library")

package(default_visibility = ["//visibility:public"])

# The provider comes from the lock: BUILD files name it, never its version.
tf_library(
    name = "greeting_lib",
    srcs = ["main.tf"],
    providers = ["@tf_providers//hashicorp/null"],
)

# This is a demo, so it keeps disposable state under bazel-bin; a real deploy
# declares a remote backend instead.
tf_deploy(
    name = "greeting",
    allow_ephemeral_state = True,
    vars = {"name": "rules_tofu"},
    deps = [":greeting_lib"],
)
