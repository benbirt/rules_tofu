load("@rules_tofu//tf:defs.bzl", "tf_deploy")

# main.tf calls cloudposse/label/null from the OpenTofu registry, which
# MODULE.bazel declares with tf_modules.module. Nothing is fetched by tofu:
# the module comes from `@tf_modules`.
tf_deploy(
    name = "label",
    srcs = ["main.tf"],
    allow_ephemeral_state = True,
    deps = ["@tf_modules//cloudposse/label/null"],
)
