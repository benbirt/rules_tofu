load("@rules_tofu//tf:defs.bzl", "tf_deploy")

# main.tf calls cloudposse/label/null from registry.opentofu.org. MODULE.bazel
# declares that module with tf_modules.module, so `tofu init` fetches nothing
# at build or run time.
#
# This is a demo, so it keeps disposable state under bazel-bin; a real deploy
# declares a remote backend instead.
tf_deploy(
    name = "label",
    srcs = ["main.tf"],
    allow_ephemeral_state = True,
    deps = ["@tf_modules//cloudposse/label/null"],
)
