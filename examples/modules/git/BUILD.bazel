load("@rules_tofu//tf:defs.bzl", "tf_deploy")

# main.tf calls Cloud Posse's label module from GitHub by tag. MODULE.bazel
# declares it with tf_modules.module as null_label. MODULE.bazel.lock records
# the commit that the tag resolved to.
#
# This is a demo, so it keeps disposable state under bazel-bin; a real deploy
# declares a remote backend instead.
tf_deploy(
    name = "git",
    srcs = ["main.tf"],
    allow_ephemeral_state = True,
    deps = ["@tf_modules//null_label"],
)
