load("@rules_tofu//tf:defs.bzl", "tf_deploy", "tf_library")

package(default_visibility = ["//visibility:public"])

# This library bundles main.tf with the Google Cloud provider it requires.
# Targets that depend on storage_bucket_lib inherit its providers automatically.
tf_library(
    name = "storage_bucket_lib",
    srcs = ["main.tf"],
    providers = ["@tf_providers//hashicorp/google"],
)

# This deploy binds variable values for storage_bucket_lib. `bazel build`
# validates it offline against the vendored provider.
# `bazel run //examples/gcp:storage_bucket.plan` reads GCP credentials at plan
# time.
#
# This is a demo, so it keeps disposable state under bazel-bin; a real deploy
# declares a remote backend instead.
tf_deploy(
    name = "storage_bucket",
    allow_ephemeral_state = True,
    vars = {
        "project": "rules_tofu-example",
        "region": "us-central1",
        "bucket_name": "rules_tofu-example-bucket",
    },
    deps = [":storage_bucket_lib"],
)
