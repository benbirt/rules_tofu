load("@rules_tofu//tf:defs.bzl", "tf_deploy", "tf_library")

package(default_visibility = ["//visibility:public"])

# Reusable library declaring the GCP provider it needs. Any deploy that
# depends on it inherits the provider through TfLibraryInfo.providers.
tf_library(
    name = "storage_bucket_lib",
    srcs = ["main.tf"],
    providers = ["@tf_providers//hashicorp/google"],
)

# Root invocation that binds variable values. `bazel build :storage_bucket`
# runs `tofu init -backend=false && tofu validate` offline against the
# vendored provider tree. `bazel run :storage_bucket.plan` then runs a real
# plan; GCP credentials are picked up by the provider at that point.
#
# This is a demo whose state is disposable, so it opts in to local state under
# bazel-bin rather than declaring a remote backend.
tf_deploy(
    name = "storage_bucket",
    allow_ephemeral_state = True,
    vars = {
        "project": "rules_tofu-example",
        "region": "us-central1",
        "bucket_name": "rules_tofu-example-bucket",
    },
    deps = [":storage_bucket_lib"],
)
