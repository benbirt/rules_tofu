load("@rules_tofu//tf:defs.bzl", "tf_deploy", "tf_library")

package(default_visibility = ["//visibility:public"])

# This library uses PostHog/posthog, a provider outside the hashicorp
# namespace. BUILD files always name providers in lower case, so its target is
# @tf_providers//posthog/posthog. MODULE.bazel omits sha256 on the provider
# tag, so Bazel records the digests from registry.opentofu.org in
# MODULE.bazel.lock.
tf_library(
    name = "dashboard_lib",
    srcs = ["main.tf"],
    providers = ["@tf_providers//posthog/posthog"],
)

# This is a demo, so it keeps disposable state under bazel-bin; a real deploy
# declares a remote backend instead.
tf_deploy(
    name = "dashboard",
    allow_ephemeral_state = True,
    vars = {"project_id": "12345"},
    deps = [":dashboard_lib"],
)
