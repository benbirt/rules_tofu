load("@rules_tofu//tf:defs.bzl", "tf_deploy", "tf_library")

package(default_visibility = ["//visibility:public"])

# This library bundles main.tf with the AWS provider it requires. Targets that
# depend on s3_bucket_lib inherit its providers automatically.
tf_library(
    name = "s3_bucket_lib",
    srcs = ["main.tf"],
    providers = ["@tf_providers//hashicorp/aws"],
)

# This deploy binds variable values for s3_bucket_lib. `bazel build` validates
# it offline against the vendored provider.
# `bazel run //examples/aws:s3_bucket.plan` reads AWS credentials at plan time.
#
# This is a demo, so it keeps disposable state under bazel-bin; a real deploy
# declares a remote backend instead.
tf_deploy(
    name = "s3_bucket",
    allow_ephemeral_state = True,
    vars = {
        "region": "us-east-1",
        "bucket_name": "rules_tofu-example-bucket",
    },
    deps = [":s3_bucket_lib"],
)
