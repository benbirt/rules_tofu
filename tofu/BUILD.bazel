# `//tofu:tofu` is the rule's only target; keeping it under `tf/private` stops
# downstream modules instantiating it instead of running `@rules_tofu//tofu`.
# buildifier: disable=bzl-visibility
load("//tf/private:tofu_binary.bzl", "tofu_binary")

# Runs the `tofu` binary the build uses, for OpenTofu commands the rules have
# no target for. `bazel run @rules_tofu//tofu -- <arguments>` runs it in the
# directory `bazel run` was started in. Other targets may also use it as a
# tool.
tofu_binary(
    name = "tofu",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "all_files",
    srcs = glob(["*"]),
    visibility = ["//:__subpackages__"],
)
