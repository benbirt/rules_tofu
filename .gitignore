bazel-*
.bazelrc.local

# Nested-module lockfiles are regenerated per run (and differ by Bazel version
# under BCR presubmit); don't commit them.
/e2e/*/MODULE.bazel.lock
/tests/integration/broken_module/MODULE.bazel.lock
/tests/integration/broken_workspace/MODULE.bazel.lock
/tests/integration/lock_dependency/MODULE.bazel.lock
